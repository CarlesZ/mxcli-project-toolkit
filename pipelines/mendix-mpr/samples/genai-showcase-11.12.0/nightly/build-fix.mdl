create or modify microflow MxGenAIConnector.ChunkCollection_PopulateCollection (
  @position(-265, -20)
  $ChunkCollection: GenAICommons.ChunkCollection,
  @position(-265, -144)
  $Collection: MxGenAIConnector.Collection
)
returns Boolean
folder 'Private/Objects/General/ChunkCollection'
begin
  @start(-265, 125)
  @position(-125, 125)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $Configuration from MxGenAIConnector.Configuration
    where MxGenAIConnector.MxCloudKnowledgeBaseResource_Configuration/MxGenAIConnector.MxCloudKnowledgeBaseResource/MxGenAIConnector.Collection_MxCloudKnowledgeBaseResource = $Collection
    first;
  @position(65, 125)
  @curve(from: (30, 0), to: (-30, 0))
  declare $RequestBody String = '';
  @position(255, 125)
  @curve(from: (30, 0), to: (-30, 0))
  declare $URL String = $Configuration/ResourceBaseUrl + '/knowledge-bases/' + $Collection/Name+ '/chunks';
  @position(445, 125)
  @curve(from: (30, 0), to: (-30, 0))
  $APIKey_Decrypted = call microflow Encryption.Decrypt(Encrypted = $Configuration/AccessToken);
  @position(635, 125)
  @curve(from: (30, 0), to: (-15, 0))
  call rest service post '{1}' with ({1} = $URL) (
    Headers: ('Content-Type': 'application/json', 'x-api-key': $APIKey_Decrypted, 'Accept': '*/*'),
    Body: template '{1}' with ({1} = $RequestBody),
    Timeout: 300,
  ) returns nothing on error without rollback begin
    @position(635, 255)
    @anchor(from: bottom)
    call microflow MxGenAIConnector.HttpResponse_LogError(MicroflowName = 'ChunkCollection_PopulateKnowledgeBase', OperationName = 'Populate Knowledge base', HttpResponse = $latestHttpResponse, AdditionalInformation_Optional = 'URL: ' + trim($URL));
    @position(635, 355)
    @anchor(to: top)
    return false;
  end error;
  @position(790, 125)
  return true;
end;

create or modify microflow MxGenAIConnector.KnowledgeBaseChunkList_GetNearestNeighbors_ByVector (
  @position(-255, -125)
  $MetadataCollection: GenAICommons.MetadataCollection,
  @position(-575, -20)
  $MaxNumberOfResults: Integer,
  @position(-255, -20)
  $MinimumSimilarity: Decimal,
  @position(-575, -125)
  $Vector: String,
  @position(-720, -125)
  $MxCloudKnowledgeBaseResource: MxGenAIConnector.MxCloudKnowledgeBaseResource,
  @position(-720, -20)
  $CollectionName: String
)
returns List of GenAICommons.KnowledgeBaseChunk
folder 'Private/Objects/General/KnowledgeBaseChunk'
begin
  @start(-720, 180)
  @position(-580, 180)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $Configuration from MxGenAIConnector.Configuration
    where MxGenAIConnector.MxCloudKnowledgeBaseResource_Configuration = $MxCloudKnowledgeBaseResource
    first;
  @position(-390, 180)
  @caption 'Configuration found?'
  if $Configuration != empty then
    @position(-200, 180)
    @curve(from: (30, 0), to: (-30, 0))
    $NewKnowledgeBaseMapping = create MxGenAIConnector.KnowledgeBaseMapping (MaxNumberOfResults = if $MaxNumberOfResults != empty then $MaxNumberOfResults
else 3, KnowledgeBaseMapping_MetadataCollection = $MetadataCollection, Vector = $Vector);
    @position(-10, 180)
    @curve(from: (30, 0), to: (-30, 0))
    declare $URL String = $Configuration/ResourceBaseUrl + '/knowledge-bases/' + $CollectionName + '/similarity';
    @position(180, 180)
    @curve(from: (30, 0), to: (-30, 0))
    $APIKey_Decrypted = call microflow Encryption.Decrypt(Encrypted = $Configuration/AccessToken);
    @position(370, 180)
    @curve(from: (30, 0), to: (-30, 0))
    $RequestBody = export to mapping MxGenAIConnector.EM_Collection_RetrieveNearestNeighors($NewKnowledgeBaseMapping);
    @position(560, 180)
    @curve(from: (30, 0), to: (-30, 0))
    $ResponseBody = call rest service post '{1}' with ({1} = $URL) (
    Headers: ('Content-Type': 'application/json', 'x-api-key': $APIKey_Decrypted, 'Accept': '*/*'),
    Body: template '{1}' with ({1} = $RequestBody),
    Timeout: 300,
  ) returns String on error without rollback begin
      @position(560, 310)
      @anchor(from: bottom)
      @curve(from: (0, 30), to: (0, -15))
      call microflow MxGenAIConnector.HttpResponse_LogError(MicroflowName = 'KnowledgeBaseChunkList_GetNearestNeighbors_ByVector', OperationName = 'Retrieve nearest neighbours', HttpResponse = $latestHttpResponse, AdditionalInformation_Optional = 'URL: ' + trim($URL));
      @position(560, 420)
      @anchor(to: top)
      return empty;
    end error;
    @position(750, 180)
    @curve(from: (30, 0), to: (-30, 0))
    $KnowledgeBaseChunkList = create list of GenAICommons.KnowledgeBaseChunk;
    @position(940, 180)
    @curve(from: (30, 0), to: (-30, 0))
    $NewKnowledgeBaseChunkList = filter $KnowledgeBaseChunkList where $MinimumSimilarity = empty or
$currentObject/Similarity >= $MinimumSimilarity;
    @position(1130, 180)
    @curve(from: (30, 0), to: (-30, 0))
    retrieve $MetadataList_Search from $MetadataCollection/GenAICommons.MetadataCollection_Metadata;
    @position(1870, 180)
    loop $IteratorKnowledgeBaseChunk in $NewKnowledgeBaseChunkList
    begin
      @position(70, 145)
      retrieve $MetadataCollection_Chunk from $IteratorKnowledgeBaseChunk/GenAICommons.KnowledgeBaseChunk_MetadataCollection;
      @position(260, 145)
      retrieve $MetadataList from $MetadataCollection_Chunk/GenAICommons.MetadataCollection_Metadata;
      @position(450, 145)
      delete $MetadataCollection_Chunk;
      @position(765, 145)
      loop $IteratorMetadata in $MetadataList
      begin
        @position(210, 100)
        $Label = call microflow GenAICommons.Metadata_GetCreate_AddToKnowledgeBaseChunk(KnowledgeBaseChunk = $IteratorKnowledgeBaseChunk, Key = $IteratorMetadata/Key, Value = $IteratorMetadata/Value, MetadataList = $MetadataList_Search);
      end loop;
      @position(1090, 145)
      delete $MetadataList;
    end loop;
    @position(2580, 180)
    return $NewKnowledgeBaseChunkList;
  else
    @position(-390, 435)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -15))
    log error node 'MxGenAI Connector' 'Missing Configuration. The MxCloudKnowledgeBaseResource object needs to be associated to a Configuration object.';
    @position(-390, 560)
    @anchor(to: top)
    return empty;
  end if;
end;

