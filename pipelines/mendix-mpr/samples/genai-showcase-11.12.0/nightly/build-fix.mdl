                  @position(353, 100)
                  call microflow GenAICommons.DeployedModel_Commit(DeployedModel = $IteratorMxCloudDeployedModel);
                end loop;
                @position(2704, -248)
                $MxCloudDeployedModel_First = head $MxCloudDeployedModelList;
                @position(2893, -248)
                @curve(from: (30, 0), to: (-30, 0))
                call microflow MxGenAIConnector.Configuration_UpdateIsCreatedInStudioPro(Configuration = $Configuration, MxCloudDeployedModel = $MxCloudDeployedModel_First);
                @position(3108, -248)
                $MxCloudKnowledgeBaseResource = call microflow AgentEditorCommons.MxCloudKnowledgeBaseResource_GetOrCreate(ModelDocumentUUID = $DocumentID);
                @position(3309, -248)
                @curve(from: (30, 0), to: (-30, 0))
                change $MxCloudKnowledgeBaseResource (ResourceDisplayName = $ConfigurationImport/DisplayName, DisplayName = $ConfigurationImport/DisplayName, CollectionIdentifierLabel = 'Collection', Architecture = @MxGenAIConnector.DeployedModelArchitecture, MxGenAIConnector.MxCloudKnowledgeBaseResource_MxCloudDeployedModel = $MxCloudDeployedModel_First);
                @position(3491, -248)
                @curve(from: (30, 0), to: (-30, 0))
                call java action GenAICommons.ConsumedKnowledgeBase_SetMicroflows(ConsumedKnowledgeBase = $MxCloudKnowledgeBaseResource, RetrievalMicroflow = 'MxGenAIConnector.KnowledgeBaseRetrieval_Retrieve', GetCollectionOptionsMicroflow = 'MxGenAIConnector.ConsumedKnowledgeBase_GetCollectionOptions', GetDeployedKnowledgeBaseMicroflow = 'MxGenAIConnector.ConsumedKnowledgeBase_GetDeployedKnowledgeBase');
                @position(3681, -248)
                @curve(from: (30, 0), to: (-30, 0))
                $Configuration_KB = call microflow AgentEditorCommons.MxCloudKnowledgeBaseResource_Configuration_GetOrCreate(MxCloudKnowledgeBaseResource = $MxCloudKnowledgeBaseResource);
                @position(3871, -248)
                change $Configuration_KB (MxGenAIConnector.Configuration_Configuration = $Configuration);
                @position(4086, -248)
                @curve(from: (30, 0), to: (-30, 0))
                call microflow MxGenAIConnector.Configuration_SetValues(Configuration = $Configuration_KB, ConfigurationImport = $ConfigurationImport, ConfigurationImport_Parent = empty);
                @position(4301, -248)
                call microflow MxGenAIConnector.Configuration_UpdateIsCreatedInStudioPro(Configuration = $Configuration_KB, MxCloudDeployedModel = $MxCloudDeployedModel_First);
                @position(4486, -248)
                @curve(from: (30, 0), to: (-30, 0))
                call microflow MxGenAIConnector.Configuration_Commit(Configuration = $Configuration_KB);
                @position(4671, -248)
                change $MxCloudKnowledgeBaseResource (ModelDocumentID = $DocumentID, _QualifiedName = $QualifiedName);
                @position(4861, -248)
                commit $MxCloudKnowledgeBaseResource refresh;
                @position(5062, -248)
                @curve(from: (30, 0), to: (-30, 0))
                call microflow AgentEditorCommons.Collection_UpdateList_Get_TaskQueue(MxCloudKnowledgeBaseResource = $MxCloudKnowledgeBaseResource) in queue AgentEditorCommons.TaskQueue_AgentEditor_Import;
                @position(5262, -248)
                add $MxCloudKnowledgeBaseResource to $ConsumedKnowledgeBaseList_ToKeep;
                @position(5402, -248)
                return true;
              else
                @position(1291, -118)
                @anchor(from: bottom, to: top)
                @curve(from: (0, 30), to: (0, -30))
                retrieve $Configuration_KB_DB from MxGenAIConnector.Configuration
    where MxGenAIConnector.Configuration_Configuration/MxGenAIConnector.Configuration/MxGenAIConnector.MxCloudDeployedModel_Configuration = $MxCloudDeployedModel_DB
    first;
                @position(1291, 12)
                @anchor(from: bottom, to: top)
                delete $Configuration_KB_DB refresh;
                @position(1291, 142)
                @anchor(from: bottom, to: top)
                @curve(from: (0, 30), to: (0, -30))
                delete $Configuration;
                @position(1291, 260)
                @anchor(from: bottom, to: top)
                log warning node @AgentEditorCommons.LogNode 'The model ID(s) for Model Document ''{1}'' could not be imported and updated in the app. 
In order to make use of the Model in the current app runtime and in the playground in Studio Pro, make sure to configure a valid value.
' with ({1} = $QualifiedName);
                @position(1291, 355)
                @anchor(to: top)
                return true;
              end if;
            when (empty), TEXT_GENERATION, KNOWLEDGE_BASE then
          end case;
          @position(-229, 622)
          @anchor(from: bottom, to: top)
          log warning node @AgentEditorCommons.LogNode 'The value set for the constant of Knowledge base ''{1}'' is not valid. It does not contain embeddings model information. The knowledge base could not be imported and updated in the app. 
In order to make use of the Knowledge base in the current app runtime and in the playground in Studio Pro, make sure to configure a valid value.
' with ({1} = $QualifiedName);
