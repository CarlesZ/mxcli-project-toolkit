      @position(519, 40)
      retrieve $AmazonBedrockKnowledgeBase from AmazonBedrockConnector.AmazonBedrockKnowledgeBase
    where KnowledgeBaseID = $ShowcaseKnowledgeBase/KnowledgeBaseID
    first;
      @position(709, 40)
