                  )
                  dynamictext text83 (
                    Content: '{1}',
                    ContentParams: ({1} = Name),
                    Class: 'text-clamp--1-line spacing-outer-left-smallest'
                  )
                }
              }
            }
            container container76 (Class: 'tooltip-col') {
              dynamictext text89 (Content: 'Last edited', Class: 'font-weight-semibold')
            }
            container container38 (Class: 'tooltip-icon-text') {
              dynamictext text90 (
                Content: '{1}',
                ContentParams: ({1} = $Version.VersionChangedDate format (dateFormat: DateTime))
              )
            }
          }
        }
        trigger {
          linkbutton actionButton22 (
            Action: call microflow AgentCommons.ACT_DoNothing,
            Icon: image 'AgentCommons.Images_AgentBuilder.info_circle_grey',
            Class: 'tooltip-info-icon ',
            DesignProperties: ('Size': 'Small', 'Spacing': ('margin-bottom': 'None'))
          )
        }
      }
    }
  }
  tooltip tooltip1 (
    renderMethod: 'custom',
    tooltipPosition: 'bottom',
    arrowPosition: 'none',
    openOn: 'hover',
    Class: 'agent-tooltip',
    Visible: $Version = empty
  ) {
    htmlmessage {
      container container8 (Class: 'tooltip-empty') {
        dynamictext text91 (Content: 'Agent version has been deleted.')
      }
    }
    trigger {
      linkbutton actionButton23 (
        Action: call microflow AgentCommons.ACT_DoNothing,
        Icon: image 'AgentCommons.Images_AgentBuilder.info_circle_grey',
        Class: 'tooltip-info-icon ',
        DesignProperties: ('Size': 'Small', 'Spacing': ('margin-bottom': 'None'))
      )
    }
  }
};

