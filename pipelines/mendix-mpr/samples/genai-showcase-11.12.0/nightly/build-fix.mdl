/**
 * Adds a new KnowledgeBaseChunk to the ChunkCollection to create the input for embeddings or knowledge base operations.
 * Optionally, add a MetadataCollection for more advanced filtering.
 * 
 * Please check the documentation for each parameter for more detailed information on how to use this operation in your project.
 */
create or modify java action GenAICommons.ChunkCollection_AddKnowledgeBaseChunk folder 'Knowledge Bases & Embeddings/1. Build Request'(EntityType: entity <"Entity"> not null, ChunkCollection: GenAICommons.ChunkCollection not null, InputText: String not null, HumanReadableID: String not null, MxObject: "Entity", MetadataCollection: GenAICommons.MetadataCollection) returns GenAICommons.KnowledgeBaseChunk
-- return NAME: 'ReturnValueName'
