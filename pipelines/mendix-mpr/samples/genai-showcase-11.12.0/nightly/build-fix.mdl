create or modify microflow Embeddings_SemanticSearchMultiColumn.ACT_Reference_ShowSource (
  @position(-155, 0)
  $Reference: GenAICommons.Reference
)
folder 'Pages/Step6_MxGenAI_RAG'
begin
  @start(-155, 200)
  @position(-15, 200)
  @curve(from: (30, 0), to: (-30, 0))
  declare $id Integer = parseInteger(
substring($Reference/Source,
findLast($Reference/Source,'id/')+3));
  @position(175, 200)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $Ticket from Embeddings_SemanticSearchMultiColumn.Ticket
    where TicketId = $id
    first;
  @position(365, 200)
