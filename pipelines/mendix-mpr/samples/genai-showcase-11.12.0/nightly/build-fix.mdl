/**
 * Use this microflow to replace a placeholder {{variable}} that you set in either your user or system prompt.
 * It will be replaced with the Value passed to this microflow. The variable only needs to contain the actual name.
 * 
 * Inputs:
 * - PromptToUse: use the "Get Prompt" action to get the object first.
 * - Variable: the name of the variable that was set in the app without surrounding curly brackets.
 * - Value: the value that should replace the placeholder.
 */
create or modify microflow AgentCommons.PromptToUse_ApplyVariable (
  @position(-495, 45)
  $PromptToUse: AgentCommons.PromptToUse,
  @position(-495, -40)
  $Variable: String,
  @position(-495, -125)
  $Value: String
)
folder 'Private/Objects/PromptToUse'
begin
  @annotation(text: 'Called from JA PromptTouse_GetAndReplace', position: (-255, -75), size: (320, 90))
  @start(-495, 130)
  @position(-350, 130)
  @curve(from: (30, 0), to: (-15, 0))
  declare $Found Boolean = false;
  @position(-160, 130)
  @merge(380, 130)
  @caption 'Variable in SystemPrompt?'
  if AgentCommons.Rule_PromptToUse_ContainsVariable(Prompt = $PromptToUse/SystemPrompt, Variable = $Variable) then
    @position(15, 130)
    @curve(from: (30, 0), to: (-30, 0))
    change $PromptToUse (SystemPrompt = replaceAll($PromptToUse/SystemPrompt, '\{\{'+ $Variable +'\}\}', $Value));
    @position(205, 130)
    @curve(from: (30, 0), to: (-15, 0))
    set $Found = true;
  end if;
  @position(540, 130)
  @merge(1080, 130)
  @caption 'Variable in UserPrompt?'
  if AgentCommons.Rule_PromptToUse_ContainsVariable(Prompt = $PromptToUse/UserPrompt, Variable = $Variable) then
    @position(715, 130)
    @curve(from: (30, 0), to: (-30, 0))
    change $PromptToUse (UserPrompt = replaceAll($PromptToUse/UserPrompt, '\{\{'+ $Variable +'\}\}', $Value));
    @position(905, 130)
    @curve(from: (30, 0), to: (-15, 0))
    set $Found = true;
  end if;
  @position(1215, 130)
  @caption 'Found'
  @annotation(text: 'Covered in JA PromptToUse_GetAndReplace', position: (1215, 5), size: (230, 50))
  if $Found then
    @position(1340, 130)
    return;
  else
    @position(1215, 240)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -15))
    log warning node @AgentCommons.LogNode 'Variable {1} not found in Agent''s prompt {2}
Agent version: {3}
' with ({1} = '{{' + $Variable +'}}', {2} = $PromptToUse/AgentCommons.PromptToUse_Version/AgentCommons.Version/AgentCommons.Version_Agent/AgentCommons.Agent/Title, {3} = (
if $PromptToUse/AgentCommons.PromptToUse_Version/AgentCommons.Version/IsDraftVersion
	then ''
	else
	'v' +
	$PromptToUse/AgentCommons.PromptToUse_Version/AgentCommons.Version/VersionNumber +' '
)+
$PromptToUse/AgentCommons.PromptToUse_Version/AgentCommons.Version/Title);
    @position(1215, 345)
    @anchor(to: top)
    return;
  end if;
end;

/**
