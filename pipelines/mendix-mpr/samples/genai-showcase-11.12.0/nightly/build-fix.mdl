              container container4 (Class: 'tooltip-version-draft ') {
                image image14 (Image: 'ConversationalUI.Image_Traces.warning_triangle', Class: 'img--14-14')
                container container7 (Class: 'spacing-outer-left-small') {
                  dynamictext text13 (Content: 'Draft ', Class: 'font-weight-semibold')
                  dynamictext text12 (Content: '(your draft might have changed after this execution)')
                }
              }
            }
            container container68 (Class: 'tooltip-col', Visible: trim($Version/Description) != '') {
              dynamictext text70 (Content: 'Description', Class: 'font-weight-semibold')
            }
            container container25 (Class: 'tooltip-col', Visible: trim($Version/Description) != '') {
              dynamictext text71 (
