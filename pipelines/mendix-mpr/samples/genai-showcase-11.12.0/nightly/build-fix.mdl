create or modify microflow ChatCompletions_FunctionCalling.ChatContext_Create (
  @position(372, 98)
  $Agent_Chat: AgentCommons.Agent,
  @position(372, 10)
  $Task: ChatCompletions_FunctionCalling.Task
)
returns ConversationalUI.ChatContext
folder 'Objects/ChatContext'
begin
  @start(372, 200)
  @position(508, 200)
  @curve(to: (-30, 0))
  $ChatContext = call java action AgentCommons.ChatContext_Create_ForAgent(Agent = $Agent_Chat, ActionMicroflow = 'ChatCompletions_FunctionCalling.ChatContext_ChatWithHistory_ActionMicroflow_FunctionCalling', ContextObjectType = 'ChatCompletions_FunctionCalling.Task', ContextObject = $Task, OverwritingDeployedModel = empty);
  @position(709, 200)
  @curve(from: (30, 0), to: (-30, 0))
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'What is the status of ticket 1?');
  @position(939, 200)
  @curve(from: (30, 0), to: (-30, 0))
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'What is the category of my ticket?');
  @position(1169, 200)
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'How many tickets were created this month?');
  @position(1399, 200)
  @curve(from: (30, 0), to: (-30, 0))
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'Are ticket 1 and 3 potential duplicates?');
  @position(1629, 200)
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'What is the newest ticket?');
  @position(1859, 200)
  @curve(from: (30, 0), to: (-30, 0))
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'How many feature tickets are in progress?');
  @position(2089, 200)
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'Create a new ticket because the wifi in the office is broken');
  @position(2319, 200)
  @curve(from: (30, 0), to: (-15, 0))
  call microflow ConversationalUI.SuggestedUserPrompt_Create(ChatContext = $ChatContext, Content = 'How can I force quit an application on Windows?');
  @position(2479, 200)
  return $ChatContext;
end;

grant execute on microflow DEV_Development.ACT_DEBUG_CallAgentDocument to DEV_Development.User;

grant execute on microflow ExampleMicroflows.ACT_TicketHelper_Agent_AgentCommons to ExampleMicroflows.User;

create or modify microflow ExampleMicroflows.Ticket_GetTicketByID (
  @position(42, 109)
  $Identifier: String
)
returns String
folder 'Single Agent'
begin
  @start(42, 200)
  @position(182, 200)
  @curve(to: (-30, 0))
  retrieve $TicketList from ExampleMicroflows.Ticket
    where Identifier = $Identifier;
  @position(372, 200)
  $JSON_Ticket = export to mapping ExampleMicroflows.EM_Ticket($TicketList);
  @position(524, 200)
  return $JSON_Ticket;
end;

create or modify microflow ExampleMicroflows.Tickets_CreateDataset ()
folder 'Ground in data - Mendix Cloud/Example data set'
begin
  @annotation(text: 'Run this microflow to get a basic data set containing tickets. E.g. add it to the after startup logic of your app.', position: (-232, -5), size: (230, 70))
  @start(-232, 200)
  @position(-92, 200)
  @curve(to: (-15, 0))
  retrieve $Ticket from ExampleMicroflows.Ticket
    first;
  @position(83, 200)
  @caption 'Ticket?'
  if $Ticket = empty then
    @position(258, 200)
    @curve(from: (30, 0), to: (-30, 0))
    declare $TicketJSON String = '[
    {
        "Identifier": "1",
        "Subject": "Unable to Save Document",
        "Description": "Every time I try to save my document, the software crashes and I lose all unsaved work. This has happened multiple times.",
        "ReproductionSteps": "1. Open the word processor. 2. Create a new document. 3. Add text to the document. 4. Attempt to save the document.",
        "Solution": "Ensure your Operating System is updated to the latest version. If the problem continues, this issue will be further investigated.",
        "Status": "In_Progress",
        "Category": "Bug"
    },
    {
        "Identifier": "2",
        "Subject": "Font Changes Not Saving",
        "Description": "When I change the font of my document, the changes do not save. When I open the document again, it reverts back to the original font.",
        "ReproductionSteps": "1. Open an existing document. 2. Change the font. 3. Save the document. 4. Close and reopen the document.",
        "Solution": "Try saving the document as a new file after making font changes. If this does not work, the issue will be further investigated.",
        "Status": "Open",
        "Category": "Bug"
    },
    {
        "Identifier": "3",
        "Subject": "Print Preview Not Accurate",
        "Description": "The print preview does not accurately reflect the formatting of my document. This makes it difficult to ensure my document will print correctly.",
        "ReproductionSteps": "1. Open a document. 2. Click on File > Print. 3. View the print preview.",
        "Solution": "This could be an issue with the printer settings. Please verify your settings. If this does not resolve the issue, it will be further investigated.",
        "Status": "Closed",
        "Category": "Bug"
    },
    {
        "Identifier": "4",
        "Subject": "Cannot Insert Images",
        "Description": "I am unable to insert images into my document. Every time I try, the software freezes and I have to restart it.",
        "ReproductionSteps": "1. Open a new document. 2. Click on Insert > Picture. 3. Select an image to insert.",
        "Solution": "Please ensure your image file is not corrupt or too large. If the issue persists, it will be further investigated.",
        "Status": "In_Progress",
        "Category": "Bug"
    },
    {
        "Identifier": "5",
        "Subject": "Copy-Paste Function Not Working",
        "Description": "The copy-paste function does not work correctly. When I paste, the formatting changes and the text becomes unreadable.",
        "ReproductionSteps": "1. Open a document. 2. Select some text. 3. Copy the text. 4. Paste the text in a new location.",
        "Solution": "Please clear your clipboard and try again. If the problem continues, it will be further investigated.",
        "Status": "Open",
        "Category": "Bug"
    },
    {
        "Identifier": "6",
        "Subject": "Error when submitting the form",
        "Description": "I encounter an error every time I try to submit the form on the website. It gives me a ''Submission failed'' message and the form data is not sent.",
        "ReproductionSteps": "1. Fill out the form
2. Click on the ''Submit'' button",
        "Solution": "Instead of directly submitting the form, please try refreshing the page and then submitting the form again. This can help in resolving any temporary issues that may be causing the submission failure.",
        "Status": "Open",
        "Category": "Bug"
    },
    {
        "Identifier": "7",
        "Subject": "Form submission not working",
        "Description": "I am unable to submit the form on the website. When I click the ''Submit'' button, nothing happens and the form data is not processed.",
        "ReproductionSteps": "1. Fill out the form
2. Press the ''Enter'' key on the keyboard",
        "Solution": "Instead of using the ''Submit'' button, please try pressing the ''Enter'' key after filling out the form fields. This may help in triggering the form submission process.",
        "Status": "Open",
        "Category": "Bug"
    },
    {
        "Identifier": "8",
        "Subject": "Issue with form data not being sent",
        "Description": "The form data is not being sent when I attempt to submit the form on the website. There is no indication of any error, but the data does not reach the intended destination.",
        "ReproductionSteps": "1. Fill out the form
2. Click outside of the form fields
3. Click on the ''Submit'' button",
        "Solution": "Instead of directly submitting the form, please try clicking outside of the form fields after filling them out and then click the ''Submit'' button. This may help in ensuring that the form data is properly processed and sent.",
        "Status": "Open",
        "Category": "Bug"
    },
    {
        "Identifier": "9",
        "Subject": "Issues with downloading attachments",
        "Description": "I am experiencing difficulties when attempting to download email attachments. The download process fails and I receive an error message indicating ''Attachment download failed''.",
        "ReproductionSteps": "1. Open an email with attachments
2. Click on the download button next to the attachment",
        "Solution": "Instead of relying on the download button, please try right-clicking on the attachment and selecting ''Save As'' to save the attachment to your desired location. This method may help in successfully downloading the attachments.",
        "Status": "Closed",
        "Category": "Bug"
    },
    {
        "Identifier": "10",
        "Subject": "Challenges with accessing shared documents",
        "Description": "I am encountering obstacles when trying to access shared documents on the network. An error message appears, stating ''Access denied'' despite having the appropriate permissions.",
        "ReproductionSteps": "1. Attempt to access the shared documents via the shortcut on the desktop",
        "Solution": "Instead of using the direct path, please try accessing the shared documents by entering the network path directly into the file explorer''s address bar. This method may help in successfully accessing the shared documents.",
        "Status": "Open",
        "Category": "Bug"
    },
    {
        "Identifier": "11",
        "Subject": "Can''t open cloud documents",
        "Description": "My team stores documents on our shared cloud-folder which I can not open. Last week, I had no problems using the provided link. However, since this morning I get an error that I don''t have the correct access rights.",
        "ReproductionSteps": "1. Copy the link that was sent to me. 2. Paste into browser. 3. Log in via my email and password. 4. Getting an error.",
        "Solution": "First, make sure that you are still part of the group by asking the person that sent the link. Second, try logging in with SSO (''Company SSO'' button). Users encountered issues when email and password were used to authenticate.",
        "Status": "Closed",
        "Category": "Bug"
    },
    {
        "Identifier": "12",
        "Subject": "Problems with printing PDF files",
        "Description": "I am facing issues when attempting to print PDF files. The printing process encounters an error and I receive a message indicating ''Print job failed''.",
        "ReproductionSteps": "1. Open a PDF file
2. Click on the print button within the PDF viewer",
        "Solution": "Instead of using the print button within the PDF viewer, please try opening the PDF file in a different viewer and printing from there. This method may help in successfully printing the PDF files.",
        "Status": "Closed",
        "Category": "Bug"
    },
    {
        "Identifier": "13",
        "Subject": "Difficulties with saving changes in documents",
        "Description": "I am experiencing difficulties when attempting to save changes in documents. After making edits, the save process fails and I receive an error message indicating ''Save failed''.",
        "ReproductionSteps": "1. Make changes to a document
2. Click on the save button in the toolbar",
        "Solution": "Instead of using the ''Save'' option, please try using the ''Save As'' option and save the document with a different file name. This method may help in successfully saving the changes in the document.",
        "Status": "Closed",
        "Category": "Bug"
    },
    {
        "Identifier": "14",
        "Subject": "Troubles with uploading images to the system",
        "Description": "I am encountering difficulties when trying to upload images to the system. The upload process fails and I receive an error message indicating ''Image upload failed''.",
        "ReproductionSteps": "1. Click on the ''Browse'' button to select images for upload",
        "Solution": "Instead of using the upload button, please try dragging and dropping the images directly into the designated upload area. This method may help in successfully uploading the images to the system.",
        "Status": "Closed",
        "Category": "Bug"
    },
    {
        "Identifier": "15",
        "Subject": "Error when connecting to VPN",
        "Description": "I am encountering an error when trying to connect to the VPN. It says ''Connection failed'' every time I attempt to establish a connection.",
