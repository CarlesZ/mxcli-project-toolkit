grant execute on microflow MultiAgentPatterns.EvaluatorOptimizer_AgentCommons to MultiAgentPatterns.User;

grant view on page ConversationalUI.Trace_Agent_SlideIn to ConversationalUI.TraceMonitoring;

create or modify microflow AgentEditorCommons.Agent_CreateUpdate_List (
  @position(-629, 54)
  $ModelDocumentList: List of AgentEditorCommons.ModelDocument
)
returns Boolean as $IsSuccess
folder 'Private/UsedByJava'
begin
  @start(-629, 214)
  @position(-471, 214)
  $AllValid = call microflow AgentEditorCommons.ModelDocument_ValidateList(ModelDocumentList = $ModelDocumentList);
  @position(-293, 214)
  @caption 'all valid?'
  if $AllValid then
    @position(-118, 214)
    @curve(from: (30, 0), to: (-30, 0))
    declare $AllSuccess Boolean = true;
    @position(72, 214)
    $AgentList_ToKeep = create list of AgentCommons.Agent;
    @position(523, 214)
    loop $IteratorAgentModelDocument in $ModelDocumentList
    begin
      @position(218, 80)
      $Agent = call microflow AgentEditorCommons.Agent_CreateUpdate(DocumentContent = $IteratorAgentModelDocument/Content, QualifiedName = $IteratorAgentModelDocument/QualifiedName, DocumentID = $IteratorAgentModelDocument/DocumentID);
      @position(382, 80)
      @caption 'succes?'
      if $Agent != empty then
        @position(529, 80)
        add $Agent to $AgentList_ToKeep;
        @position(618, 80)
        continue;
      else
        @position(382, 198)
        @anchor(to: top)
        set $AllSuccess = false;
        @position(618, 198)
        break;
      end if;
    end loop;
    @position(960, 214)
    @caption 'all success?'
    if $AllSuccess then
      @position(1135, 214)
      @curve(from: (30, 0), to: (-30, 0))
      retrieve $AgentList_FromModel from AgentCommons.Agent
    where ModelDocumentID != empty;
      @position(1325, 214)
      @curve(from: (30, 0), to: (-30, 0))
      $AgentList_ToDelete = subtract $AgentList_ToKeep from $AgentList_FromModel;
      @position(1520, 214)
      $Count_ToDelete = count $AgentList_ToDelete;
      @position(1720, 214)
      @curve(from: (30, 0), to: (-30, 0))
