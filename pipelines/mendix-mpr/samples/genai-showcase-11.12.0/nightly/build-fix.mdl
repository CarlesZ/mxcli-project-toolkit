create or modify rule AgentCommons.Rule_ToolList_Equals (
  @position(-385, -10)
  $ToolList_Right: List of AgentCommons.Tool,
  @position(-385, 87)
  $ToolList_Left: List of AgentCommons.Tool
)
returns Boolean
folder 'Private/Objects/Tool'
begin
  @start(-385, 200)
  @position(-245, 200)
  @curve(to: (-30, 0))
  $Count_Right = count $ToolList_Right;
  @position(-55, 200)
  @curve(to: (-15, 0))
  $Count_Left = count $ToolList_Left;
  @position(120, 200)
  @caption 'same number of elements?'
  if $Count_Left = $Count_Right then
    @position(295, 200)
    @curve(to: (-30, 0))
    declare $MismatchFound Boolean = false;
    @position(712, 200)
    @anchor(from: right, to: left)
    loop $IteratorTool in $ToolList_Right
    begin
      @position(70, 128)
      $Tool_Left_Duplicate = find $ToolList_Left where $currentObject/Description = $IteratorTool/Description and
$currentObject/IsEnabled = $IteratorTool/IsEnabled and
$currentObject/Microflow = $IteratorTool/Microflow and
$currentObject/Name = $IteratorTool/Name;
      @position(241, 128)
      @caption 'difference?'
      if $Tool_Left_Duplicate = empty then
        @position(416, 128)
        set $MismatchFound = true;
        @position(556, 128)
        break;
      else
        @position(241, 203)
        @anchor(to: top)
        continue;
      end if;
    end loop;
    @position(1117, 200)
    @caption 'no Mismatch found?'
    if $MismatchFound = false then
      @position(1242, 200)
      return true;
    else
      @position(1117, 288)
      @anchor(to: top)
      return false;
    end if;
  else
    @position(120, 303)
    @anchor(to: top)
    return false;
  end if;
end;

