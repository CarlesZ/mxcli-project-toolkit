        @position(899, 170)
        @anchor(from: bottom)
        @curve(from: (0, 30), to: (0, -30))
        change $ShowcaseKnowledgeBase (RetrieveSuccessful = false) refresh;
        @position(899, 300)
        @anchor(from: bottom, to: top)
        @curve(from: (0, 30), to: (0, -15))
        log error node 'ListFoundationModels' '{1}: {2}

' with ({1} = $latestError/ErrorType, {2} = $latestError/Message);
        @position(899, 390)
        @anchor(to: top)
        return false;
      end error;
      @position(1094, 40)
      @curve(from: (30, 0), to: (-15, 0))
      change $ShowcaseKnowledgeBase (RetrieveSuccessful = true) refresh;
      @position(1254, 40)
      return true;
    else
      @position(-51, 175)
      @anchor(from: bottom, to: top)
      @curve(from: (0, 30), to: (0, -15))
      show message 'Please configure authentication settings first.' type Error blocking;
      @position(-51, 295)
      @anchor(to: top)
      return false;
