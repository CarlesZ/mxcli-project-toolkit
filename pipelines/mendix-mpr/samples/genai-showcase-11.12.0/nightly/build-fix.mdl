create or modify rule MxGenAIConnector.ConfigurationImport_IsKnowledgeBasewithEmbeddings (
  @position(50, 65)
  $ConfigurationImport: MxGenAIConnector.ConfigurationImport
)
returns Boolean
folder 'Private/Objects/General/ConfigurationImport'
begin
  -- WARNING: the merge at (920, 200) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(50, 200)
  @position(185, 200)
  @caption 'KB resource'
  case $ConfigurationImport/ResourceType
    when KNOWLEDGE_BASE then
      @position(445, 200)
      retrieve $ConfigurationImport_Embeddings from $ConfigurationImport/MxGenAIConnector.ConfigurationImport_ConfigurationImport;
      @position(620, 200)
      @caption 'Has Embeddings'
      if $ConfigurationImport_Embeddings != empty then
        @position(745, 200)
        return true;
      else
        @position(620, 390)
        @anchor(to: top)
        return false;
      end if;
    when TEXT_GENERATION, (empty), EMBEDDINGS_GENERATION then
  end case;
  @position(185, 390)
  @anchor(to: top)
  return false;
end;

create or modify rule OpenAIConnector.Rule_Configuration_KeyTypeToUse (
  @position(70, 45)
  $Configuration: OpenAIConnector.Configuration
)
returns enum OpenAIConnector.ENUM_KeyType
folder 'Private/Resources/Configuration'
begin
  -- WARNING: the merge at (915, 200) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(70, 200)
  @position(195, 200)
  @caption 'api type?'
  case $Configuration/ApiType
    when AzureOpenAI then
      @position(445, 200)
      @caption 'key type?'
      case $Configuration/KeyType
        when Bearer_Token then
          join shared1;
        when API_key then
          @position(825, 295)
          return OpenAIConnector.ENUM_KeyType.API_key;
        when (empty) then
          @position(445, 345)
          @anchor(to: top)
          return empty;
      end case;
    when OpenAI then
    when (empty) then
      @position(195, 345)
      @anchor(to: top)
      return empty;
  end case;
  join shared1;
  @position(700, 200)
  merge shared1;
  @position(825, 200)
  return OpenAIConnector.ENUM_KeyType.Bearer_Token;
end;

