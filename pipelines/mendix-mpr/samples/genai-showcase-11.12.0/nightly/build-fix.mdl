create or modify microflow AgentEditorCommons.AgentFromModel_Validate (
  @position(-2119, -10)
  $AgentFromModel: AgentEditorCommons.AgentFromModel
)
returns String
folder 'Private/AgentFromModel'
begin
  @start(-2119, 126)
  @position(-1977, 126)
  @curve(from: (30, 0), to: (-15, 0))
  declare $ValidationMessage String = '';
  @position(-1779, 126)
  @anchor(true: (to: top))
  @merge(-1644, 126)
  @caption 'UsageType'
  if not($AgentFromModel/UsageType != empty) then
    @position(-1779, 256)
    @anchor(to: top)
    @curve(to: (0, 15))
    set $ValidationMessage = $ValidationMessage + '
Usage Type is missing for the Agent.';
  end if;
  @position(-1494, 126)
  @curve(from: (30, 0), to: (-15, 0))
  $UsageType = call microflow AgentEditorCommons.UsageType_StringToENUM(UsageType = $AgentFromModel/UsageType);
  @position(-1319, 126)
  @anchor(true: (to: top))
  @merge(-1184, 126)
  @caption 'parsed usage type?'
  if not($UsageType != empty) then
    @position(-1319, 256)
    @anchor(to: top)
    @curve(to: (0, 15))
    set $ValidationMessage = $ValidationMessage + '
Usage Type is not valid for the Agent.';
  end if;
  @position(-883, 126)
  @anchor(true: (to: top))
  @merge(-744, 126)
  @caption 'model document?'
  if not(trim($AgentFromModel/Model) != '') then
    @position(-883, 256)
    @anchor(to: top)
    @curve(from: (30, 0), to: (0, 15))
    set $ValidationMessage = $ValidationMessage + '
No Model document is referenced for the Agent.';
  end if;
  @position(-594, 126)
  @anchor(true: (to: top))
  @merge(-455, 126)
  @caption 'model id selected?'
  if not(trim($AgentFromModel/SelectedModelID) != '') then
    @position(-594, 256)
    @anchor(to: top)
    @curve(from: (30, 0), to: (0, 15))
    set $ValidationMessage = $ValidationMessage + '
Model with name ' + $AgentFromModel/SelectedModelID + ' is referenced but could not be found for the Agent.';
  end if;
  @position(-305, 126)
  $ToolChoice = call microflow AgentEditorCommons.ToolChoice_StringToENUM(ToolChoice = $AgentFromModel/ToolChoice);
  @position(-145, 126)
  @merge(900, 126)
  @caption 'Tool choice = tool'
  if $ToolChoice = GenAICommons.ENUM_ToolChoice.tool then
    @position(25, 326)
    @merge(860, 326)
    @caption 'Tool set'
    if trim($AgentFromModel/ToolChoice_Tool) != '' then
      @position(195, 326)
      retrieve $ToolFromModelList from $AgentFromModel/AgentEditorCommons.ToolFromModel_AgentFromModel;
      @position(355, 326)
      $ToolFromModel_ToolChoice = find $ToolFromModelList where $currentObject/Name = $AgentFromModel/ToolChoice_Tool and $currentObject/Enabled = true;
      @position(515, 326)
      @merge(805, 326)
      @caption 'Tool found in tool list'
      if not($ToolFromModel_ToolChoice != empty) then
        @position(685, 426)
        set $ValidationMessage = $ValidationMessage + '
Tool choice is set to Tool, but tool with name ' + $AgentFromModel/ToolChoice_Tool + ' wasn''t found in the agent''s tools.';
      end if;
    else
      @position(195, 476)
      set $ValidationMessage = $ValidationMessage + '
Tool choice is set to Tool, but no Tool name was provided.';
    end if;
  end if;
  @position(1020, 126)
  return trim($ValidationMessage);
end;

