create or modify microflow AgentEditorCommons.Agent_CreateUpdate (
  @position(-32, 2)
  $DocumentContent: String,
  @position(-32, -94)
  $QualifiedName: String,
  @position(-32, -198)
  $DocumentID: String
)
returns AgentCommons.Agent as $Agent
folder 'Private/Agent'
begin
  @start(-5, 137)
  @position(122, 137)
  @curve(from: (30, 0), to: (-30, 0))
  $AgentFromModel = import from mapping AgentEditorCommons.IM_AgentFromModel($DocumentContent) on error without rollback begin
    @position(122, 267)
    @anchor(from: bottom)
    log error node @AgentEditorCommons.LogNode 'An error occurred while importing an Agent document: {3}
Message: {1}
ErrorType: {2}' with ({1} = $latestError/Message, {2} = $latestError/ErrorType, {3} = $QualifiedName);
    @position(122, 350)
    @anchor(to: top)
    return empty;
  end error;
  @position(331, 137)
  $Agent = call microflow AgentEditorCommons.AgentFromModel_CreateUpdateAgent(AgentFromModel = $AgentFromModel, QualifiedName = $QualifiedName, DocumentID = $DocumentID);
  @position(499, 137)
  return $Agent;
end;

create or modify microflow AgentEditorCommons.MxCloudDeployedModel_CreateUpdateFromModel (
  @position(-2725, -289)
  $DocumentContent: String,
  @position(-2725, -383)
  $QualifiedName: String,
  @position(-2725, -479)
  $DocumentID: String,
  @position(-2725, -575)
  $DeployedModelList_ToKeep: List of GenAICommons.DeployedModel
)
returns Boolean as $IsSuccess
folder 'Private/MxCloudDeployedModel'
begin
  @start(-2795, -142)
  @position(-2655, -142)
  $DeployedModelFromModel = import from mapping AgentEditorCommons.IM_MxCloudDeployedModel($DocumentContent) on error without rollback begin
    @position(-2655, 54)
    @anchor(from: bottom)
    log error node @AgentEditorCommons.LogNode 'An error occurred while importing a Mendix Cloud Model document.
Message: {1}
ErrorType: {2}' with ({1} = $latestError/Message, {2} = $latestError/ErrorType);
    @position(-2655, 119)
    @anchor(to: top)
    return false;
  end error;
  @position(-2465, -142)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $MxCloudFieldsList from $DeployedModelFromModel/AgentEditorCommons.MxCloudFields_DeployedModelFromModel;
  @position(-2275, -142)
  @curve(from: (30, 0), to: (-15, 0))
  $MxCloudFields = head $MxCloudFieldsList;
  @position(-2100, -142)
  @caption 'key?'
  if trim($MxCloudFields/Key) != '' then
    @position(-1921, -142)
    @curve(from: (30, 0), to: (-15, 0))
    $ConstantValue = call java action AgentEditorCommons.GetConstantValue(QualifiedName = $MxCloudFields/Key);
    @position(-1746, -142)
    @caption 'constant value?'
    if trim($ConstantValue) != '' then
      @position(-1541, -142)
      @curve(from: (30, 0), to: (-15, 0))
      $ConfigurationImport = call microflow MxGenAIConnector.ConfigurationStringImport_DecodeAndImport(ConfigurationImportString = $ConstantValue);
      @position(-1377, -142)
      @caption 'import success?'
      if $ConfigurationImport != empty then
        @position(-1202, -142)
        @curve(from: (30, 0), to: (-15, 0))
        $ValidationMessage = call microflow MxGenAIConnector.ConfigurationImport_Validate(ConfigurationImport = $ConfigurationImport);
        @position(-1033, -142)
        @caption 'Valid'
        if trim($ValidationMessage) = '' then
          @position(-835, -142)
          @curve(from: (30, 0), to: (-30, 0))
          @annotation(text: 'See if there is an existing DeployedModel with the UUID', position: (-835, -324), size: (230, 50))
          retrieve $MxCloudDeployedModel_DB from MxGenAIConnector.MxCloudDeployedModel
    where GenAICommons.DeployedModel.ModelDocumentID = $DocumentID
    first;
          @position(-430, -142)
          @annotation(text: '...so that we can get the configuration for the time being, until we have DocumentID on this Configuration.', position: (-430, -324), size: (230, 80))
          $Configuration = call microflow AgentEditorCommons.MxCloudDeployedModel_Configuration_GetOrCreate(MxCloudDeployedModel = $MxCloudDeployedModel_DB);
          @position(48, -142)
          $Configuration_ToUse = call microflow AgentEditorCommons.Configuration_CleanupModelsIfKeyIsFromDifferentResource(Configuration = $Configuration, ConfigurationImport = $ConfigurationImport);
          @position(527, -142)
          @curve(from: (30, 0), to: (-30, 0))
          call microflow MxGenAIConnector.Configuration_SetValues(Configuration = $Configuration_ToUse, ConfigurationImport = $ConfigurationImport, ConfigurationImport_Parent = empty);
          @position(747, -142)
          change $Configuration_ToUse (IsCreatedInStudioPro = true);
          @position(967, -142)
          @curve(from: (30, 0), to: (-15, 0))
          $ModelDetailsList = call microflow MxGenAIConnector.Configuration_ModelDetails_GET(Configuration = $Configuration_ToUse);
          @position(1163, -142)
          @caption 'ModelDetailsList?'
          if $ModelDetailsList != empty then
            @position(1333, -142)
            @annotation(id: n1, text: 'For now only commit configuration if the resource can be reached. Unfortunately we have to, otherwise we have no place to store the ModelDocumentUUID and incorrect model documents will clutter local database. 
In a future iteration the ModelDoucmentID field should move to the Configuration to correspond to the Model Document, instead of the IsCreatedInStudioPro boolean.', position: (1471, 163), size: (300, 140))
            call microflow MxGenAIConnector.Configuration_Commit(Configuration = $Configuration_ToUse);
            @position(1558, -142)
            @curve(from: (30, 0), to: (-30, 0))
            call microflow MxGenAIConnector.Configuration_CreateSetAndCommitMxCloudDeployedModel(Configuration = $Configuration_ToUse, ModelDetailsList = $ModelDetailsList);
            @position(1981, -142)
            retrieve $MxCloudDeployedModelList from $Configuration_ToUse/MxGenAIConnector.MxCloudDeployedModel_Configuration;
            @position(2266, -142)
            loop $IteratorMxCloudDeployedModel in $MxCloudDeployedModelList
            begin
              @position(194, 100)
              change $IteratorMxCloudDeployedModel (GenAICommons.DeployedModel.ModelDocumentID = $DocumentID, GenAICommons.DeployedModel._QualifiedName = $QualifiedName);
            end loop;
