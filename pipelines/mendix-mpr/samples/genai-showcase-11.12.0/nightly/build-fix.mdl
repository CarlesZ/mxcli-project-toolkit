returns String as $Summarization
folder 'USE_ME/Agent Templates'
exposed as microflow action 'Summarization Agent' in 'Agents Kit (Templates)'
begin
  @annotation(text: 'This agent summarizes various types of content, such as articles, essays, book chapters, or speeches.', position: (240, 20), size: (330, 60))
  @start(-25, 200)
  @position(114, 200)
  $SummarizationAgent = call microflow AgentCommons.Agent_GetCreate_Json(AgentTitle = 'Summarization Agent', AgentJson = '{
    "Title": "Summarization Agent",
    "Description": "This agent summarizes various types of content, such as articles, essays, book chapters, or speeches.",
    "UsageType": "Single_Call",
    "UUID": "aef3d185-81e9-4b36-aac6-5a657eb89de0",
    "Versions": [
        {
            "Title": "First version",
            "SystemPrompt": "Summarize the main points of the given text in no more than 3-5 concise sentences. Focus on capturing the key ideas, central argument, or core message while omitting unnecessary details. Your summary should provide a clear and accurate overview that someone unfamiliar with the original text can easily understand.",
            "UserPrompt": "Prompt engineering involves the skillful structuring of instructions to guide generative Artificial Intelligence (AI) models in producing the desired outcomes, blending technical precision and creativity. With today’s more advanced models, it has become easier for models to interpret user intent with minimal input, becoming more user-friendly, and in exchange, users have adapted their language to be better understood by the Large Language Models (LLM).\n\nThese prompts typically contain input from the end-user or are generated by the app which is enriched with instructions from the developer/administrator or enriched by the app. A prompt typically contains at least one of the following:\n\n- instructions on what the model should do\n- context and information that the model needs to follow the instructions\n- the relevant input data (from the end-user or passed from a microflow)\n- the requested output structure (e.g. tone of voice or a JSON format)\n\nThe prompts are key components in the interaction with GenAI. When implementing patterns like RAG and ReAct as a developer, you can influence the system’s behavior by modifying the prompt. You need to explain to the system how to use the knowledge and functions that are provided, otherwise, it might ignore them, act differently, or start hallucinating.",
            "VersionNumber": 1,
            "UUID": "6805809a-003c-477a-a762-8bd9ddd831ee",
            "VersionChangedDate": "2025-05-06T11:15:49.710Z",
            "DeployedModel": {
                "Architecture": "Mendix Cloud",
                "Model": "anthropic.claude-3-5-sonnet-20240620-v1:0"
            }
        }
    ],
    "Version_InUse": {
        "UUID": "6805809a-003c-477a-a762-8bd9ddd831ee"
    }
}');
  @position(304, 200)
  @curve(to: (-30, 0))
  $Request = call microflow GenAICommons.Request_Create(SystemPrompt = empty, Temperature = empty, MaxTokens = empty, TopP = empty, ID = empty);
  @position(494, 200)
  @curve(to: (-30, 0))
  call microflow GenAICommons.Request_AddMessage(Request = $Request, ENUM_MessageRole = GenAICommons.ENUM_MessageRole.user, FileCollection = empty, ContentString = $TextToSummarize);
  @position(684, 200)
  $Response = call java action AgentCommons.Agent_Call_WithHistory(Agent = $SummarizationAgent, Request = $Request, ContextObjectType = 'System.User', OptionalContextObject = empty);
  @position(831, 200)
  return $Response/ResponseText;
end;

