grant execute on microflow Embeddings_RAG.ACT_Reference_ShowSource to Embeddings_RAG.User;

create or modify microflow Embeddings_RAG.KnowledgeBaseItem_ChunkCollection_CreateKnowledgebaseChunks (
  @position(-870, 85)
  $KnowledgeBaseItem: Embeddings_RAG.KnowledgeBaseItem,
  @position(-870, -20)
  $ChunkCollection: GenAICommons.ChunkCollection
)
folder 'Objects/KnowledgeBaseItem'
begin
  @start(-870, 200)
  @position(-690, 200)
  @curve(from: (30, 0), to: (-30, 0))
  declare $KnowledgeBaseText String = trim(replaceAll($KnowledgeBaseItem/Content, '''', ''''''));
  @position(-203, 200)
  while length($KnowledgeBaseText) > 0
  begin
    @position(60, 135)
    $MetaDataCollection = call microflow GenAICommons.MetadataCollection_CreateAndAddMetadata(Key = 'sourceUrl', Value = 'https://www.gutenberg.org/cache/epub/10852/pg10852-images.html');
    @position(200, 135)
    @caption 'full chunk size available?'
    if length($KnowledgeBaseText) >= @Embeddings_RAG.ChunkSizeCharacters then
      @position(435, 135)
      call java action GenAICommons.ChunkCollection_AddKnowledgeBaseChunk(ChunkCollection = $ChunkCollection, InputText = substring($KnowledgeBaseText, 0, @Embeddings_RAG.ChunkSizeCharacters), HumanReadableID = 'flowertext', EntityType = 'System.User', MxObject = empty, MetadataCollection = $MetaDataCollection);
      @position(615, 135)
      @annotation(text: 'divide the length by 2 so that we get overlapping chunks', position: (70, -5), size: (230, 50))
      set $KnowledgeBaseText = substring($KnowledgeBaseText, ceil(@Embeddings_RAG.ChunkSizeCharacters : 2));
    else
      @position(435, 215)
      call java action GenAICommons.ChunkCollection_AddKnowledgeBaseChunk(ChunkCollection = $ChunkCollection, InputText = substring($KnowledgeBaseText, 0, length($KnowledgeBaseText)), HumanReadableID = 'flowertext', EntityType = 'System.User', MxObject = empty, MetadataCollection = $MetaDataCollection);
      @position(615, 215)
      set $KnowledgeBaseText = '';
    end if;
  end while;
  @position(265, 200)
  return;
end;

create or modify microflow Embeddings_SemanticSearch.BookList_AddChunks (
  @position(-155, 110)
  $ChunkCollection: GenAICommons.ChunkCollection
)
folder 'Objects/Book'
begin
  @start(-155, 200)
  @position(-15, 200)
  @curve(to: (-30, 0))
  $BookList = call microflow Embeddings_SemanticSearch.Book_GetList();
  @position(270, 200)
  loop $IteratorBook in $BookList
  begin
    @position(150, 90)
    call java action GenAICommons.ChunkCollection_AddKnowledgeBaseChunk(ChunkCollection = $ChunkCollection, InputText = $IteratorBook/Description, HumanReadableID = empty, EntityType = 'Embeddings_SemanticSearch.Book', MxObject = $IteratorBook, MetadataCollection = empty);
  end loop;
  @position(510, 200)
  return;
end;

