mdl 1;
-- build-fix.mdl -- MDL fixes that take the GenAI Showcase rehost target (nightly run, N-2 snippet already replaced)
-- from 42 CE1613 (+ the errors hidden behind them) to `mx check` 0 errors. See BUILD-FIX.md for the why of every block.
-- Replay: cp -a target-nightly-unblocked target-fix && mxcli exec -p target-fix/GenAITarget.mpr build-fix.mdl
-- then the non-MDL steps listed in BUILD-FIX.md (mxcli fix widgets, mxcli fix design-properties, vendorlib, Java sources).
-- Almost every document below is the target's own describe output with a few lines changed; each changed line is
-- named in BUILD-FIX.md. Statements are topologically ordered (pipelines/mendix-mpr/lib/topo-order-mdl.py).

-- Part 1: managed JAR dependencies the extractor never carries (module settings are not in the catalog).
alter module MCPClient
  add jar dependency (
    group    = 'io.modelcontextprotocol.sdk',
    artifact = 'mcp',
    version  = '1.1.1',
    included = true,
  );
alter module MCPClient set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'io.modelcontextprotocol.sdk:mcp-json-jackson3';
alter module MCPClient set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'tools.jackson.core:jackson-core';
alter module MCPClient set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'tools.jackson.core:jackson-databind';
alter module MCPClient set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'tools.jackson.dataformat:jackson-dataformat-yaml';
alter module MCPClient set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'com.networknt:json-schema-validator';
alter module MCPClient
  add jar dependency (
    group    = 'io.modelcontextprotocol.sdk',
    artifact = 'mcp-json-jackson2',
    version  = '1.1.1',
    included = true,
  );
alter module MCPClient
  add jar dependency (
    group    = 'com.fasterxml.jackson.core',
    artifact = 'jackson-databind',
    version  = '[2.21.2,3)',
    included = true,
  );
alter module GenAICommons
  add jar dependency (
    group    = 'com.fasterxml.jackson.core',
    artifact = 'jackson-databind',
    version  = '[2.21.2,3)',
    included = true,
  );
