-- Part 6: Ticket event handlers (entity first, then BCo/BDe, then the handlers -- exec cannot create either side first).
alter entity ExampleMicroflows.Ticket add event handler on before commit call ExampleMicroflows.BCo_Ticket($currentObject) raise error;
alter entity ExampleMicroflows.Ticket add event handler on before delete call ExampleMicroflows.BDe_Ticket($currentObject) raise error;

