create or modify rule AgentCommons.Rule_Version_IsUnedited (
  @position(-668, 115)
  $Version_Draft: AgentCommons.Version
)
returns Boolean
folder 'Private/Objects/Version'
begin
  @start(-668, 200)
  @position(-523, 200)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $VersionList_PotentialDuplicates from AgentCommons.Version
    where [AgentCommons.Version_Agent = $Version_Draft/AgentCommons.Version_Agent]
    [SystemPrompt = $Version_Draft/SystemPrompt]
    [UserPrompt = $Version_Draft/UserPrompt]
    [ToolChoice = $Version_Draft/ToolChoice]
    [Temperature = $Version_Draft/Temperature]
    [MaxTokens = $Version_Draft/MaxTokens]
    [TopP = $Version_Draft/TopP]
    [AgentCommons.Version_DeployedModel = $Version_Draft/AgentCommons.Version_DeployedModel]
    [not(IsDraftVersion)];
  @position(-337, 200)
  @caption 'Any version with identical prompts?'
  if $VersionList_PotentialDuplicates != empty then
    @position(-162, 200)
    @curve(to: (-30, 0))
    declare $FoundMatch Boolean = false;
    @position(28, 200)
    @curve(to: (-30, 0))
    retrieve $ToolList_Draft from $Version_Draft/AgentCommons.Tool_Version;
    @position(218, 200)
    retrieve $KnowledgeBaseList_Draft from $Version_Draft/AgentCommons.KnowledgeBase_Version;
    @position(1179, 200)
    @anchor(from: right, to: left)
    loop $IteratorVersion in $VersionList_PotentialDuplicates
    begin
      @position(68, 155)
      retrieve $ToolList from $IteratorVersion/AgentCommons.Tool_Version;
      @position(231, 155)
      @merge(523, 257)
      @caption 'same tools?'
      if AgentCommons.Rule_ToolList_Equals(ToolList_Right = $ToolList_Draft, ToolList_Left = $ToolList) then
        @position(374, 155)
        retrieve $KnowledgeBaseList from $IteratorVersion/AgentCommons.KnowledgeBase_Version;
        @position(523, 155)
        @caption 'same knowledge bases?'
        if AgentCommons.Rule_KnowledgeBaseList_Equals(KnowledgeBaseList_Right = $KnowledgeBaseList_Draft, KnowledgeBaseList_Left = $KnowledgeBaseList) then
          @position(683, 155)
          @merge(1356, 155)
          @caption 'tool as tool choice?'
          if $IteratorVersion/ToolChoice = GenAICommons.ENUM_ToolChoice.tool then
            @position(858, 155)
            retrieve $Tool_ChoiceDraft from $Version_Draft/AgentCommons.Version_ToolChoice;
            @position(1048, 155)
            retrieve $Tool_ChoiceVersion from $IteratorVersion/AgentCommons.Version_ToolChoice;
