        Content: '{1}',
        ContentParams: ({1} = createdDate format (dateFormat: DateTime)),
        DesignProperties: ('Size': 'Small', 'Color': 'Detail color')
      )
    }
  }
  container container53 (Visible: $PageHelper.IsTestRunning in (false)) {
    container container54 (Visible: $PageHelper/NumberOfTestRuns = 0) {
      snippetcall snippetCall9 (Snippet: AgentCommons.Snippet_OutputInfo, Params: (PageHelper = $PageHelper))
    }
    container container68 (Visible: $PageHelper/IsTestRunSuccessful and $PageHelper/NumberOfTestRuns > 1) {
      container container5 (Class: 'output-align-header') {
        container container69 (Class: 'output-grid-container agent-table-header') {
          dynamictext text73 (
            Content: 'Test case',
            Class: 'output-grid-item',
            DesignProperties: ('Weight': 'Semibold')
          )
          dynamictext text74 (Content: 'Output', Class: 'output-grid-item', DesignProperties: ('Weight': 'Semibold'))
          dynamictext text75 (
            Content: 'Input tokens',
            Class: 'output-grid-item',
            DesignProperties: ('Weight': 'Semibold')
          )
          dynamictext text76 (
            Content: 'Output tokens',
            Class: 'output-grid-item',
            DesignProperties: ('Weight': 'Semibold')
          )
          dynamictext text77 (Content: 'Duration', Class: 'output-grid-item', DesignProperties: ('Weight': 'Semibold'))
        }
      }
      container container4 {
        container container1 (DesignProperties: ('Spacing': ('margin-right': 'S'))) {
          listview listView5 (
            DataSource: microflow AgentCommons.DS_PageHelper_GetTestRunList(PageHelper = $PageHelper),
            PageSize: 10,
            DesignProperties: ('Style': 'No styling')
          ) {
            -- Context: $currentObject (AgentCommons.TestRun), $listView5 (selection)
            container container70 (Class: 'output-grid-container') {
              container container10 (Class: 'output-grid-item') {
                tooltip tooltip2 (
                  renderMethod: 'custom',
                  tooltipPosition: 'bottom',
                  arrowPosition: 'end',
                  openOn: 'hoverFocus',
                  Class: 'agent-tooltip output-tooltip'
                ) {
                  htmlmessage {
                    listview listView2 (
                      DataSource: microflow AgentCommons.DS_TestRun_GetVariables,
                      PageSize: 10,
                      Editable: true,
                      Class: 'custom-tooltip-listview',
                      DesignProperties: ('Style': 'No styling', 'Spacing': ('margin-left': 'None', 'margin-right': 'None'))
                    ) {
                      -- Context: $currentObject (AgentCommons.Value), $listView2 (selection)
                      container container2 (
                        Class: 'output-tooltip-grid',
                        DesignProperties: ('Spacing': ('margin-bottom': 'M'))
                      ) {
                        dynamictext text15 (
                          Content: 'HANDOFF variable key',
                          Class: 'output-tooltip-grid-item',
                          DesignProperties: ('Weight': 'Semibold', 'Size': 'Small', 'Spacing': ('margin-top': 'None', 'margin-bottom': 'None'))
                        )
                        dynamictext text79 (
                          Content: '{1}',
                          ContentParams: ({1} = if length($currentObject/Value) > 55 then substring($currentObject/Value, 0, 55) + '...'
else $currentObject/Value),
                          Class: 'output-tooltip-grid-item',
                          DesignProperties: ('Weight': 'Normal', 'Size': 'Small', 'Wrap options': 'Wrap', 'Spacing': ('margin-top': 'None', 'margin-bottom': 'None')),
                          Visible: trim($currentObject/Value) != empty
                        )
                        container container3 (
                          Class: 'output-tooltip-grid output-tooltip-with-icon ',
                          Visible: if trim($currentObject/Value) = '' then true
else false
                        ) {
                          dynamictext text1 (
                            Content: 'Not filled',
                            DesignProperties: ('Weight': 'Normal', 'Size': 'Small')
                          )
                        }
                      }
                    }
                  }
                  trigger {
                    dynamictext text78 (
                      Content: '{1}',
                      ContentParams: ({1} = AgentCommons.TestRun_TestCase/Name),
                      Class: 'display--inline',
                      DesignProperties: ('Wrap options': 'Wrap')
                    )
                    linkbutton actionButton21 (
                      Action: call microflow AgentCommons.ACT_DoNothing,
                      Icon: image 'AgentCommons.Images_AgentBuilder.info_circle_grey',
                      Class: 'info-icon',
                      DesignProperties: ('Size': 'Small', 'Spacing': ('margin-bottom': 'None'))
                    )
                  }
                }
              }
              markdown markdownViewer1 (stringAttribute: OutputText)
              container container9 (Class: 'output-grid-item') {
                dynamictext text81 (Content: '{1}', ContentParams: ({1} = InputTokens), Class: 'output-grid-item')
              }
              container container8 (Class: 'output-grid-item') {
                dynamictext text82 (Content: '{1}', ContentParams: ({1} = OutputTokens), Class: 'output-grid-item')
              }
              container container6 (Class: 'output-grid-item') {
                dynamictext text83 (
                  Content: '{1} s',
                  ContentParams: ({1} = DurationSeconds format (decimalPrecision: 1, groupDigits: true)),
                  Class: 'output-grid-item'
                )
              }
            }
          }
        }
      }
    }
  }
  snippetcall snippetCall4 (Snippet: AgentCommons.Snippet_LoadingDots, Params: (PageHelper = $PageHelper))
};

