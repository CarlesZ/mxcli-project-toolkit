      tooltip tooltip3 (
        renderMethod: 'custom',
        tooltipPosition: 'bottom',
        arrowPosition: 'end',
        openOn: 'hover',
        Class: 'agent-tooltip'
      ) {
        htmlmessage {
          container container103 (Class: 'tooltip-container-version ') {
            container container67 (Class: 'tooltip-col') {
              dynamictext text69 (Content: 'Agent version', Class: 'font-weight-semibold')
            }
