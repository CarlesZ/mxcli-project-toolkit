create or modify microflow MultiAgentPatterns.EvaluatorOptimizer_AgentCommons (
  @position(-3, -23)
  $Query: MultiAgentPatterns.Query
)
folder 'Patterns/Evaluator Optimizer/Approach using Agent Commons'
begin
  @annotation(text: 'In the evaluator-optimizer workflow, one LLM generates a response while another provides evaluation and feedback in a loop until the evaluation criteria are met or max attempts are reached.

In this example, we have a model generating a poem about the topic given by the user in the user prompt. The evaluator agent has instructions to evaulate the haiku based on
1. adherence to form
2. imagery, and
3. emotional impact.

If the haiku does not meet all criteria, the optimizer agent is provided with feedback on the last attempt and generate a new haiku.
This process is continues until the evaluator agent doesn''t have any feedback. The process ends and the latest attempt of the optimizer agent is returned. ', position: (936, -370), size: (1070, 190))
  @start(-3, 142)
  @position(137, 142)
  @curve(from: (30, 0), to: (-30, 0))
  $NewOptimizerInput = create MultiAgentPatterns.OptimizerInput (UserInput = $Query/UserInput);
  @position(327, 142)
  declare $AttemptsLeft Integer = 10;
  @position(517, 142)
  @curve(from: (30, 0), to: (-30, 0))
  $Agent_Optimizer = call microflow AgentCommons.Agent_GetCreate_Json(AgentTitle = 'Poem Writer / Optimizer', AgentJson = '{"Title":"Poem Writer / Optimizer","Description":"This is the initial text writer agent and optimizer agent for the \"Evaluator/Optimizer\" multi-agent pattern example","UsageType":"Single_Call","UUID":"aa885f2b-cb32-478d-969a-1384121fa81b","Versions":[{"Title":"First version","SystemPrompt":"Your goal is to generate content for the task given to you by the user.\nOnly output the text.\nIn case you are given a generated text already, if so, your task is to improve it based on the feedback that comes along with it. Always keep the original task in mind.\nOnly output the text, remove any preamble or additional sentences.","UserPrompt":"Task: Write a poem about {{UserInput}}.\n\nText to improve: {{TextToOptimize}}\n\nFeedback: {{Feedback}}","VersionNumber":1,"UUID":"96cad94e-50c2-48dd-98c0-b740103be875","VersionChangedDate":"2025-08-22T14:44:40.060Z","DeployedModel":{"Architecture":"Mendix Cloud","Model":"anthropic.claude-3-5-sonnet-20240620-v1:0"}}],"Variables":[{"Key":"UserInput"},{"Key":"Feedback"},{"Key":"TextToOptimize"}],"Version_InUse":{"UUID":"96cad94e-50c2-48dd-98c0-b740103be875"},"Entity":"MultiAgentPatterns.OptimizerInput"}');
  @position(719, 142)
  @curve(to: (-30, 0))
  $Agent_Evaluator = call microflow AgentCommons.Agent_GetCreate_Json(AgentTitle = 'Poem Evaluator', AgentJson = '{"Title":"Poem Evaluator","Description":"This is the evaluator agent in the \"Evaluator/Optimizer\" multi-agent pattern.","UsageType":"Single_Call","UUID":"fed6e240-1fc3-4148-8051-a2c798886840","Versions":[{"Title":"First version","SystemPrompt":"The user will provide you with a haiku. Evaluate the haiku for\n1. adherence to form\n2. imagery, and\n3. emotional impact.\n\nIf you were not provided with a text, ask for the text.\nYou should be evaluating only and not attempting to solve the task.\nIf the implementation does not meet the specified criteria give feedback and set the status to \"INVALID\".\nIf the text meets all criteria and you have no further suggestions for improvements, set the status to \"VALID\".\nReturn ONLY a json in the following format:\n{\n  \"feedback\": \"string\",\n  \"status\": \"string\"\n}","UserPrompt":"{{ResponseText}}","VersionNumber":1,"UUID":"3c809104-2e8a-4497-89ad-05ed9eb8de43","VersionChangedDate":"2025-08-22T14:47:48.045Z","DeployedModel":{"Architecture":"Mendix Cloud","Model":"anthropic.claude-3-5-sonnet-20240620-v1:0"}}],"Variables":[{"Key":"ResponseText"}],"Version_InUse":{"UUID":"3c809104-2e8a-4497-89ad-05ed9eb8de43"},"Entity":"GenAICommons.Response"}');
  @position(1603, 142)
  while $AttemptsLeft > 0
  begin
    @position(344, 218)
    $Response_Optimizer = call java action AgentCommons.Agent_Call_WithoutHistory(Agent = $Agent_Optimizer, ContextObjectType = 'MultiAgentPatterns.OptimizerInput', OptionalContextObject = $NewOptimizerInput, OptionalRequest = empty, OptionalFileCollection = empty);
    @position(524, 218)
    call microflow MultiAgentPatterns.AgentLogging_Create(ResponseText = $Response_Optimizer/ResponseText, AgentName = 'Generator/Optimizer agent', Query = $Query, IsFinalResponse = false, IsFallBack = false);
    @position(707, 218)
    $Response_Evaluator = call java action AgentCommons.Agent_Call_WithoutHistory(Agent = $Agent_Evaluator, ContextObjectType = 'GenAICommons.Response', OptionalContextObject = $Response_Optimizer, OptionalRequest = empty, OptionalFileCollection = empty);
    @position(886, 218)
    call microflow MultiAgentPatterns.AgentLogging_Create(ResponseText = $Response_Evaluator/ResponseText, AgentName = 'Evaluator agent', Query = $Query, IsFinalResponse = false, IsFallBack = false);
    @position(1059, 218)
    @caption 'Status is valid'
    if contains(toLowerCase($Response_Evaluator/ResponseText), 'valid')
and contains(toLowerCase($Response_Evaluator/ResponseText), 'invalid') = false then
      @position(1249, 218)
      change $Query (AgentResponse = $Response_Optimizer/ResponseText) refresh;
      @position(1399, 218)
      break;
    else
      @position(1059, 348)
      @anchor(from: bottom, to: top)
      change $NewOptimizerInput (TextToOptimize = $Response_Optimizer/ResponseText, Feedback = $Response_Evaluator/ResponseText);
      @position(1059, 464)
      @anchor(from: bottom, to: top)
      set $AttemptsLeft = $AttemptsLeft - 1;
      @position(1059, 544)
      @anchor(to: top)
      continue;
    end if;
  end while;
  @position(2457, 142)
  return;
end;

