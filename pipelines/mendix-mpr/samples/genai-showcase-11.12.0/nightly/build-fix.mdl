create or modify snippet General.Snippet_KnowledgeBase_SyncWarning folder 'Resources/KnowledgeBase' (Params: ( $ConfigurationSelection: General.ConfigurationSelection )) {
  dataview dataView1 (
    DataSource: microflow General.DS_ConfigurationSelection_KnowledgeBaseUpdate(ConfigurationSelection = $ConfigurationSelection),
    ShowFooter: true,
    ReadOnlyStyle: Control
  ) {
    -- Context: $currentObject (General.KnowledgeBaseUpdate)
    container container11 (
      Class: 'alert alert-warning',
      DesignProperties: ('Spacing': ('padding-top': 'M', 'padding-bottom': 'M', 'padding-left': 'M', 'padding-right': 'M')),
      Visible: $ConfigurationSelection/KnowledgeBaseArchitecture = General.ENUM_KnowledgeBaseArchitecture.MxCloud
and
$currentObject/LastChanged != empty 
and
secondsBetween($currentObject/LastChanged, [%CurrentDateTime%]) < 120
    ) {
      layoutgrid layoutGrid6 {
        row {
          column (DesktopWidth: AutoFit, TabletWidth: AutoFit, PhoneWidth: AutoFit, VerticalAlignment: Start) {
          }
          column (DesktopWidth: AutoFill, VerticalAlignment: Center) {
            dynamictext text28 (
              Content: 'Warning',
              RenderMode: H5,
              Class: 'alert-title',
              DesignProperties: ('Weight': 'Bold', 'Spacing': ('margin-bottom': 'None'))
            )
            dynamictext text31 (
              Content: 'The knowledge base was updated recently. Due to asynchronous data synchronization the data is only available for read operations in the knowledge base within 60-120 seconds. You might need to refresh or navigate back to this page in order to see results.',
              RenderMode: Paragraph,
              Class: 'alert-description',
              DesignProperties: ('Spacing': ('margin-bottom': 'None'))
            )
          }
        }
      }
    }
  }
};

