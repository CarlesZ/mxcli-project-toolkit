/**
 * The Retrieve Nearest Neighbors activity is used to retrieve chunks from the knowledge base ordered by similarity based on the given vector. For additional filtering, provide a MetadataCollection (see the Initialize MetadataCollection with Metadata section and the Add Metadata to MetadataCollection section). Lastly, MinimumSimilarity (range 0 - 1.0) and MaxNumberOfResults can be used for optional filtering. This operation returns a list of chunks, sorted on similarity, in a single operation.
 * 
 * Additional filtering can be done by specifying the optional input parameters:
 * -MinimumSimilarity (in the range 0-1.0): acts as a cut-off: chunks are not retrieved if they have a similarity below this value.
 * -MaxNumberOfResults: determines the max number of similar chunks that are returned.
 * -MetadataCollection: when provided, this operation only returns chunks that are conform with all of the metadata key/value pairs in the collection.
 * 
 * Output:
 * - KnowledgeBaseChunkList: This list is the result of the retrieval.
 * 
 * The DeployedKnowledgeBase entity passed must be of type PgVectorKnowledgeBase. It must contain the Name string attribute filled and a DatabaseConfiguration associated with the connection details to a PostgreSQL database server with the PgVector extension installed. This DatabaseConfiguration entity is typically configured at runtime or in after-startup logic. By providing the Name on the DeployedKnowledgeBase, you determine the knowledge base.
 */
create or modify microflow PgVectorKnowledgeBase.KnowledgeBaseChunkList_RetrieveNearestNeighbors (
  @position(-525, -100)
  $Vector: String,
  @position(-95, 0)
  $MinimumSimilarity: Decimal,
  @position(-240, 0)
  $MaxNumberOfResults: Integer,
  @position(-525, 0)
  $DeployedKnowledgeBase: GenAICommons.DeployedKnowledgeBase,
  @position(-370, 0)
  $MetadataCollection: GenAICommons.MetadataCollection
)
returns List of GenAICommons.KnowledgeBaseChunk
folder 'USE_ME/Operations/Retrieve'
exposed as microflow action 'Retrieve Nearest Neighbors' in 'PgVector Knowledge Base'
begin
  @annotation(text: 'optional parameters', position: (-240, -60), size: (310, 30))
  @annotation(text: 'The Retrieve Nearest Neighbors activity is used to retrieve chunks from the knowledge base ordered by similarity based on the given vector. For additional filtering, provide a MetadataCollection (see the Initialize MetadataCollection with Metadata section and the Add Metadata to MetadataCollection section). Lastly, MinimumSimilarity (range 0 - 1.0) and MaxNumberOfResults can be used for optional filtering. This operation returns a list of chunks, sorted on similarity, in a single operation.

Additional filtering can be done by specifying the optional input parameters:
-MinimumSimilarity (in the range 0-1.0): acts as a cut-off: chunks are not retrieved if they have a similarity below this value.
-MaxNumberOfResults: determines the max number of similar chunks that are returned.
-MetadataCollection: when provided, this operation only returns chunks that are conform with all of the metadata key/value pairs in the collection.

Output:
- KnowledgeBaseChunkList: This list is the result of the retrieval.

The DeployedKnowledgeBase entity passed must be of type PgVectorKnowledgeBase. It must contain the Name string attribute filled and a DatabaseConfiguration associated with the connection details to a PostgreSQL database server with the PgVector extension installed. This DatabaseConfiguration entity is typically configured at runtime or in after-startup logic. By providing the Name on the DeployedKnowledgeBase, you determine the knowledge base.', position: (580, -120), size: (980, 290))
  @start(-525, 200)
  @position(-325, 200)
  @curve(from: (30, 0), to: (-15, 0))
  $DatabaseConfiguration = call microflow PgVectorKnowledgeBase.DeployedKnowledgeBase_GetDatabaseConfiguration_PgVectorKnowledgeBase(DeployedKnowledgeBase = $DeployedKnowledgeBase);
  @position(-75, 200)
  @caption 'Database configured'
  if PgVectorKnowledgeBase.Rule_DatabaseConfiguration_IsConfigured(DatabaseConfiguration = $DatabaseConfiguration) then
    @position(127, 200)
    @caption 'KB name?'
    if trim($DeployedKnowledgeBase/Name) != '' then
      @position(337, 200)
      @curve(to: (-30, 0))
      $QueryResultList = call microflow PgVectorKnowledgeBase.DatabaseConfiguration_SelectNearestNeighbors(Vector = $Vector, MaxNumberOfResults = $MaxNumberOfResults, MinimumSimilarity = $MinimumSimilarity, KnowledgeBaseName = $DeployedKnowledgeBase/Name, DatabaseConfiguration = $DatabaseConfiguration, MetadataCollection = $MetadataCollection);
      @position(547, 200)
      @curve(from: (30, 0), to: (-30, 0))
      $Variable = call microflow PgVectorKnowledgeBase.QueryResultList_RetrieveAndAddMetadata(QueryResultList = $QueryResultList, KnowledgeBaseName = $DeployedKnowledgeBase/Name, DatabaseConfiguration = $DatabaseConfiguration);
      @position(737, 200)
      $KnowledgeBaseChunkList = call microflow PgVectorKnowledgeBase.QueryResultList_MapToKnowledgeBaseChunks(QueryResultList = $QueryResultList, MetadataCollection = $MetadataCollection);
      return $KnowledgeBaseChunkList;
    else
      @position(127, 330)
      @anchor(from: bottom, to: top)
      @curve(from: (0, 30), to: (0, -15))
      log error node 'PgVectorKnowledgeBase' 'No knowledge base name was provided for the DeployedKnowledgeBase..';
      @position(127, 450)
      @anchor(to: top)
      return empty;
    end if;
  else
    @position(-75, 330)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -15))
    log error node 'PgVectorKnowledgeBase' 'No database configuration was configured for the DeployedKnowledgeBase.';
    @position(-75, 450)
    @anchor(to: top)
    return empty;
  end if;
end;

