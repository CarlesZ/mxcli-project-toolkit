              if $ModelDetailsList != empty then
                @position(1461, -248)
                call microflow MxGenAIConnector.Configuration_Commit(Configuration = $Configuration);
                @position(1686, -248)
                @curve(from: (30, 0), to: (-30, 0))
                call microflow MxGenAIConnector.Configuration_CreateSetAndCommitMxCloudDeployedModel(Configuration = $Configuration, ModelDetailsList = $ModelDetailsList);
                @position(1934, -248)
                retrieve $MxCloudDeployedModelList from $Configuration/MxGenAIConnector.MxCloudDeployedModel_Configuration;
                @position(2319, -248)
                loop $IteratorMxCloudDeployedModel in $MxCloudDeployedModelList
                begin
                  @position(163, 100)
