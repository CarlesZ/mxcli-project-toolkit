create or modify microflow ChatCompletions_JsonModeDemoData.Car_GenerateRecords_GetUserPrompt (
  @position(-745, 20)
  $Number: Integer
)
returns String
folder 'Objects/Car'
begin
  @start(-745, 130)
  @position(-605, 130)
  @caption '>=1?'
  if $Number != empty 
and
$Number >= 1 then
    @position(-400, 130)
    @curve(from: (30, 0), to: (-30, 0))
    declare $JsonTemplate String = '{
  "cars": [
    {
      "licensePlate": "string",
      "color": "string",
      "productionDate": "2023-05-15",
      "brand": "string"
    }
  ]
}';
    @position(-210, 130)
    @curve(to: (-30, 0))
    declare $UserPrompt String = 'Create a JSON representation for ' + $Number + ' demo records that represent cars in the outside world. The template that should be used is as follows ' + $JsonTemplate + '. The options for the brand are "qvantum", "eclipsios", "elysiane" and "zenith". The production date needs to be in the past 20 years, mostly on the first of the month and needs to be in the format yyyy-MM-dd. The license plate formatting should resemble real license plates from various countries.';
    @position(-20, 130)
    @curve(from: (30, 0), to: (-15, 0))
    retrieve $Car from ChatCompletions_JsonModeDemoData.Car
    first;
    @position(155, 130)
    @caption 'any data already exiting?'
    if $Car != empty then
      @position(330, 130)
      @curve(from: (30, 0), to: (-30, 0))
      retrieve $CarList from ChatCompletions_JsonModeDemoData.Car;
      @position(520, 130)
      @curve(from: (30, 0), to: (-30, 0))
      declare $Json_ExistingCarData String = '';
      @position(710, 130)
      @curve(from: (30, 0), to: (-15, 0))
      set $UserPrompt = $UserPrompt + ' The following data already exists and should not be duplicated: ' + $Json_ExistingCarData;
      @position(850, 130)
      return $UserPrompt;
    else
      @position(850, 245)
      return $UserPrompt;
    end if;
  else
    @position(-605, 260)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -15))
    log error node 'Car Generate Records' 'No valid desired number of records provided (must be >= 1). Provided: {1}' with ({1} = toString($Number));
    @position(-605, 370)
    @anchor(to: top)
    return empty;
  end if;
end;

create or modify microflow ConversationalUI.SpanTreeView_CreateForToolCallConfirmation (
  @position(73, 55)
  $Span: GenAICommons.Span
)
returns ConversationalUI.SpanTreeView as $SpanTreeViewToolCall
folder 'Private/Traceability/Objects/SpanTreeView'
begin
  -- WARNING: the merge at (1001, 140) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(73, 140)
  @position(248, 140)
  @curve(from: (30, 0), to: (-30, 0))
  $ToolSpan = call microflow GenAICommons.ToolSpan_Cast(Span = $Span);
  @position(438, 140)
  declare $Title String = '';
  @position(613, 140)
  @caption 'Status'
  case $ToolSpan/ToolCallStatus
    when Approved, ExecutedApproved then
      @position(892, 25)
      set $Title = 'User approval ' + $ToolSpan/ToolName;
    when Pending then
      @position(892, 140)
      set $Title = 'User confirmation ' + $ToolSpan/ToolName;
    when ExecutedDeclined, Declined then
      @position(892, 260)
      set $Title = 'User rejection ' + $ToolSpan/ToolName;
    when ExecutedVisible, ExecutedHidden, (empty) then
      @position(613, 374)
      @anchor(to: top)
      return empty;
  end case;
  join shared1;
  merge shared1;
  @position(1161, 140)
  @curve(from: (30, 0), to: (-30, 0))
  $SpanTreeView_ToolConfirmation = call microflow ConversationalUI.SpanTreeView_Create(SpanType = ConversationalUI.ENUM_SpanType.ToolCallUserConfirmation, Title = $Title, TotalTokens = empty, SpanID = $Span/SpanId, TraceID = empty, StartTime = $Span/createdDate, DurationInS = if $ToolSpan/StartTime != empty
then millisecondsBetween($ToolSpan/createdDate, $ToolSpan/StartTime)
else millisecondsBetween($ToolSpan/createdDate, [%CurrentDateTime%]));
  @position(1361, 140)
  change $SpanTreeView_ToolConfirmation (ToolCallStatus = $ToolSpan/ToolCallStatus);
  @position(1534, 140)
  return $SpanTreeView_ToolConfirmation;
end;

create or modify microflow ConversationalUI.SpanTreeView_CreateFromSpan (
  @position(-512, 96)
  $Span: GenAICommons.Span
)
returns ConversationalUI.SpanTreeView as $SpanTreeView
folder 'Private/Traceability/Objects/SpanTreeView'
begin
  @annotation(text: 'empty means the tool was not executed yet', position: (-374, 122), size: (230, 50))
  @start(-512, 200)
  @position(-387, 200)
  @caption 'Duration?'
  if $Span/DurationMilliseconds != empty then
    @position(-227, 200)
    split type $Span
      when GenAICommons.ModelSpan then
        @position(3, 200)
        cast $ModelSpan;
        @position(178, 200)
        $SpanTreeView_Model = call microflow ConversationalUI.SpanTreeView_Create(SpanType = ConversationalUI.ENUM_SpanType.ModelCall, Title = 'Text Generation', TotalTokens = if $ModelSpan/Input != empty and $ModelSpan/Output!= empty then
$ModelSpan/InputTokens + $ModelSpan/OutputTokens
else 0, SpanID = $ModelSpan/SpanId, TraceID = empty, StartTime = $Span/StartTime, DurationInS = round($Span/DurationMilliseconds:1000,3));
        @position(359, 200)
        return $SpanTreeView_Model;
      when GenAICommons.KnowledgeBaseSpan then
        @position(3, 461)
        cast $KnowledgeBaseSpan;
        @position(178, 461)
        $SpanTreeView_KnowledgeBase = call microflow ConversationalUI.SpanTreeView_Create(SpanType = ConversationalUI.ENUM_SpanType.KnowledgeBaseCall, Title = $KnowledgeBaseSpan/ToolName, TotalTokens = empty, SpanID = $Span/SpanId, TraceID = empty, StartTime = $Span/StartTime, DurationInS = round($Span/DurationMilliseconds:1000,3));
        @position(359, 461)
        return $SpanTreeView_KnowledgeBase;
      when GenAICommons.MCPSpan then
        @position(3, 608)
        cast $MCPSpan;
        @position(178, 608)
        $SpanTreeView_MCP = call microflow ConversationalUI.SpanTreeView_Create(SpanType = ConversationalUI.ENUM_SpanType.MCPCall, Title = $MCPSpan/ToolName, TotalTokens = empty, SpanID = $Span/SpanId, TraceID = empty, StartTime = $Span/StartTime, DurationInS = round($Span/DurationMilliseconds:1000,3));
        @position(359, 608)
        return $SpanTreeView_MCP;
      when GenAICommons.ToolSpan then
        @position(3, 324)
        cast $ToolSpan;
        @position(178, 324)
        $SpanTreeView_Tool = call microflow ConversationalUI.SpanTreeView_Create(SpanType = ConversationalUI.ENUM_SpanType.ToolCall, Title = $ToolSpan/ToolName, TotalTokens = empty, SpanID = $Span/SpanId, TraceID = empty, StartTime = $Span/StartTime, DurationInS = round($Span/DurationMilliseconds:1000,3));
        @position(359, 324)
        return $SpanTreeView_Tool;
      when GenAICommons.Span then
    end split;
    @position(-227, 568)
    @anchor(to: top)
    return empty;
  else
    @position(-387, 303)
    @anchor(to: top)
    return empty;
  end if;
end;

create or modify microflow ConversationalUI.SpanTreeView_GetListWithOffsets (
  @position(-1335, 58)
  $Trace: GenAICommons.Trace,
  @position(-1335, -32)
  $SpanTreeView_Input: ConversationalUI.SpanTreeView
)
returns List of ConversationalUI.SpanTreeView as $SpanTreeViewList
folder 'Private/Traceability/Objects/SpanTreeView'
begin
  @annotation(text: 'Charts with the same x-axis need to be created for all spans in a trace. For this reason, the total value of the bar needs to be the duration of the whole trace. To be able to show the actual value of the span, we need to add an offset value to the front and the end and makes these values invisible. This is why these are shown as white in the charts.', position: (-666, 46), size: (490, 90))
  @start(-1335, 200)
  @position(-1210, 200)
  @caption 'Not ToolCallUserConfirmation'
  if $SpanTreeView_Input/SpanType != ConversationalUI.ENUM_SpanType.ToolCallUserConfirmation then
    @position(-1035, 200)
    $SpanTreeViewList = create list of ConversationalUI.SpanTreeView;
    @position(-845, 200)
    @curve(from: (30, 0), to: (-15, 0))
    retrieve $Span from $SpanTreeView_Input/ConversationalUI.SpanTreeView_Span;
    @position(-670, 200)
    @caption 'Duration?'
    if $Span/DurationMilliseconds != empty then
      @position(-495, 200)
      $SpanTreeView = call microflow ConversationalUI.SpanTreeView_CreateFromSpanForChartWithOffset(Span = $Span, DurationInS = round($Span/DurationMilliseconds:1000, 3), IsOffset = false);
      @position(-315, 200)
      @curve(from: (30, 0), to: (-30, 0))
      $SpanTreeView_Offset_Start = call microflow ConversationalUI.SpanTreeView_CreateFromSpanForChartWithOffset(Span = $Span, DurationInS = if $SpanTreeView_Input/MillisecondsBeforeExecution != 0
then $SpanTreeView_Input/MillisecondsBeforeExecution : 1000
else 0, IsOffset = true);
      @position(-138, 200)
      @curve(to: (-30, 0))
      $SpanTreeView_Offset_End = call microflow ConversationalUI.SpanTreeView_CreateFromSpanForChartWithOffset(Span = $Span, DurationInS = ($Trace/DurationMilliseconds - $SpanTreeView_Input/MillisecondsBeforeExecution - $Span/DurationMilliseconds) :1000, IsOffset = true);
      @position(39, 200)
      add $SpanTreeView_Offset_Start to $SpanTreeViewList;
      @position(229, 200)
      @curve(from: (30, 0), to: (-30, 0))
      add $SpanTreeView to $SpanTreeViewList;
      @position(401, 200)
      @curve(from: (30, 0), to: (-15, 0))
      add $SpanTreeView_Offset_End to $SpanTreeViewList;
      @position(525, 200)
      return $SpanTreeViewList;
    else
      @position(-670, 287)
      @anchor(to: top)
      return empty;
    end if;
  else
    @position(-1210, 287)
    @anchor(to: top)
    return empty;
  end if;
end;

create or modify microflow Embeddings_Clustering.Cluster_GenerateUserPrompt (
  @position(-700, -70)
  $ClusterList: List of Embeddings_Clustering.Cluster
)
returns String
folder 'Objects/Cluster'
begin
  @start(-700, 100)
  @position(-560, 100)
  @curve(from: (30, 0), to: (-30, 0))
  $ClusterDetailsList = create list of Embeddings_Clustering.ClusterDetails;
  @position(-35, 100)
  loop $IteratorCluster in $ClusterList
  begin
    @position(95, 180)
    $NewClusterDetails = create Embeddings_Clustering.ClusterDetails (Identifier = $IteratorCluster/Identifier);
    retrieve $DataList_Subset from Embeddings_Clustering.Data
    where Embeddings_Clustering.Data_Cluster = $IteratorCluster
    limit 5;
    @position(510, 180)
    loop $IteratorData in $DataList_Subset
    begin
      @position(145, 100)
      $NewText = create Embeddings_Clustering.Text (Text = $IteratorData/Text, Text_ClusterDetails = $NewClusterDetails);
    end loop;
    @position(765, 180)
    add $NewClusterDetails to $ClusterDetailsList;
  end loop;
  @position(525, 100)
  @curve(from: (30, 0), to: (-30, 0))
  declare $ClusterJSON String = '';
  @position(715, 100)
  @curve(from: (30, 0), to: (-15, 0))
  declare $UserPrompt String = 'Create a name and a description for each data cluster distinguised by the "identifier" attribute in the json. Below a subset of texts within each cluster is provided. Base the answer on the following input:

' + $ClusterJSON;
  @position(855, 100)
  return $UserPrompt;
end;

