)
returns Boolean
folder 'Objects/ShowcaseKnowledgeBase/Retrieve'
begin
  @start(-379, 40)
  @position(-229, 40)
  @curve(from: (30, 0), to: (-30, 0))
  $NewRequest = call microflow GenAICommons.Request_Create(SystemPrompt = '', Temperature = 0, MaxTokens = 0, TopP = 0, ID = empty);
  @position(-39, 40)
  @curve(from: (30, 0), to: (-30, 0))
  call microflow GenAICommons.Request_AddMessage(Request = $NewRequest, ENUM_MessageRole = empty, FileCollection = empty, ContentString = 'Where to eat mexican food');
  @position(151, 40)
  @curve(from: (30, 0), to: (-15, 0))
  $Settings = call microflow RAG_Knowledgebase_AmazonBedrock.Settings_Retrieve();
  @position(326, 40)
  @caption 'Settings available?'
  if $Settings!=empty then
    @position(501, 40)
    retrieve $AmazonBedrockKnowledgeBase from AmazonBedrockConnector.AmazonBedrockKnowledgeBase
    where KnowledgeBaseID = $ShowcaseKnowledgeBase/KnowledgeBaseID
    first;
    @position(691, 40)
    @curve(from: (30, 0), to: (-30, 0))
    call microflow AmazonBedrockConnector.RetrieveRequest_Extension_Create(Request = $NewRequest, DeployedKnowledgeBase = $AmazonBedrockKnowledgeBase, NextToken = empty, NumberOfResults = 2);
    @position(881, 40)
    @curve(from: (30, 0), to: (-30, 0))
    $RetrieveResponse = call microflow AmazonBedrockConnector.Retrieve(Request = $NewRequest) on error without rollback begin
      @position(881, 160)
      @anchor(from: bottom)
      @curve(from: (0, 30), to: (0, -15))
      log error node 'ListFoundationModels' '{1}: {2}

' with ({1} = $latestError/ErrorType, {2} = $latestError/Message);
      @position(881, 290)
      @anchor(to: top)
      raise error;
    end error;
    @position(1101, 40)
    @curve(from: (30, 0), to: (-15, 0))
    $Convert = call microflow RAG_Knowledgebase_AmazonBedrock.RetrieveResponse_Convert(Response = $RetrieveResponse, ShowcaseKnowledgeBase = $ShowcaseKnowledgeBase);
    @position(1291, 40)
    @caption 'Convert'
    if $Convert then
      @position(1591, 40)
      return true;
    else
      @position(1291, 160)
      @anchor(from: bottom, to: top)
      @curve(from: (0, 30), to: (0, -15))
      log error node 'Retrieve Response' '''Fail to convert the Retrieve Response''
';
      @position(1291, 240)
      @anchor(to: top)
      return false;
    end if;
  else
    @position(326, 175)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -15))
    show message 'Please configure authentication settings first.' type Error blocking;
    @position(326, 295)
    @anchor(to: top)
    return false;
  end if;
end;

