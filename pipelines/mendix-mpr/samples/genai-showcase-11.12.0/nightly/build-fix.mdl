            }
            container container73 (Class: 'tooltip-col', Visible: $currentObject/NrOfKBCalls != 0) {
              dynamictext text82 (Content: 'Knowledge base
', Class: 'font-weight-semibold')
            }
            container container5 (Class: 'tooltip-col', Visible: $currentObject/NrOfKBCalls != 0) {
              listview listView2 (
                DataSource: database from $Version/AgentCommons.KnowledgeBase_Version/AgentCommons.KnowledgeBase,
