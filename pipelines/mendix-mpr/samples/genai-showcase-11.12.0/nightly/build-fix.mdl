    group    = 'software.amazon.awssdk',
    artifact = 'bedrockruntime',
    version  = '[2,3)',
    included = true,
  );
alter module AmazonBedrockConnector
  add jar dependency (
    group    = 'software.amazon.awssdk',
    artifact = 'bedrockagent',
    version  = '[2,3)',
    included = true,
  );
alter module AmazonBedrockConnector
  add jar dependency (
    group    = 'software.amazon.awssdk',
    artifact = 'bedrockagentruntime',
    version  = '[2.27,3)',
    included = true,
  );
alter module AmazonBedrockConnector
  add jar dependency (
    group    = 'com.fasterxml.jackson.core',
    artifact = 'jackson-databind',
    version  = '[2.21.2,3)',
    included = true,
  );
alter module MCPServer
  add jar dependency (
    group    = 'io.modelcontextprotocol.sdk',
    artifact = 'mcp',
    version  = '1.1.1',
    included = true,
  );
alter module MCPServer set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'io.modelcontextprotocol.sdk:mcp-json-jackson3';
alter module MCPServer set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'tools.jackson.core:jackson-core';
alter module MCPServer set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'tools.jackson.core:jackson-databind';
alter module MCPServer set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'tools.jackson.dataformat:jackson-dataformat-yaml';
alter module MCPServer set jar dependency 'io.modelcontextprotocol.sdk:mcp'
  add exclusion 'com.networknt:json-schema-validator';
alter module MCPServer
  add jar dependency (
    group    = 'io.modelcontextprotocol.sdk',
    artifact = 'mcp-json-jackson2',
    version  = '1.1.1',
    included = true,
  );
alter module MCPServer
