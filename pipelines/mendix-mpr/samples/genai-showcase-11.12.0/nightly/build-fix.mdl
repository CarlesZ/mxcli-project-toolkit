create or modify microflow ExampleMicroflows.ACT_Product_GenerateProductDescription (
  @position(-406, 95)
  $Product: ExampleMicroflows.Product
)
folder 'Prompt Engineering'
begin
  @start(-406, 200)
  @position(-261, 200)
  @curve(from: (30, 0), to: (-30, 0))
  @annotation(text: 'Example to show how prompt variables can be changed with logic from your app rather than user''s input.', position: (-261, -41), size: (230, 70))
  change $Product (Language = 'English');
  @position(-71, 200)
  @curve(to: (-30, 0))
  @annotation(text: 'Get the agent that was created in the UI from the database. In this example, the title is hardcoded. Make sure to change the retrieve accordingly to fit your use case.', position: (-71, 53), size: (240, 70))
  retrieve $Agent from AgentCommons.Agent
    where Title = 'Product Description Generator'
    first;
  @position(119, 200)
  @curve(to: (-30, 0))
  $Response = call java action AgentCommons.Agent_Call_WithoutHistory(Agent = $Agent, ContextObjectType = 'ExampleMicroflows.Product', OptionalContextObject = $Product, OptionalRequest = empty, OptionalFileCollection = empty);
  @position(306, 200)
  @curve(from: (30, 0), to: (-15, 0))
  change $Product (ProductDescription = $Response/ResponseText);
  @position(446, 200)
  return;
end;

create or modify microflow ExampleMicroflows.ACT_TicketHelper_Agent_AgentCommons (
  @position(-629, 0)
  $TicketHelper: ExampleMicroflows.TicketHelper
)
folder 'Single Agent'
begin
  @annotation(text: 'Note: this microflow only works after following the "how-to create a single agent" on MxDocs.', position: (-434, -88), size: (270, 90))
  @start(-629, 200)
  @position(-490, 200)
  @curve(to: (-30, 0))
  @annotation(text: 'Get Agent (by hardcoded title)', position: (-490, 74), size: (160, 60))
  retrieve $Agent from AgentCommons.Agent
    where Title = 'IT-Ticket Helper'
    first;
  @position(-248, 200)
  @curve(to: (-30, 0))
  @annotation(text: 'Execute Call Agent. It uses the TicketHelper input object to replace variable with $TicketHelper/UserInput.', position: (-248, 74), size: (230, 60))
  $Response = call java action AgentCommons.Agent_Call_WithoutHistory(Agent = $Agent, ContextObjectType = 'ExampleMicroflows.TicketHelper', OptionalContextObject = $TicketHelper, OptionalRequest = empty, OptionalFileCollection = empty);
  @position(20, 200)
  @annotation(text: ' Add the response to the UI object', position: (20, 74), size: (230, 60))
  change $TicketHelper (ModelResponse = $Response/ResponseText);
  @position(157, 200)
  return;
end;

create or modify microflow ExampleMicroflows.ACT_TicketList_LoadAllIntoKnowledgeBase ()
folder 'Ground in data - Mendix Cloud/Sync Mendix app data'
begin
  @annotation(text: 'This microflow is set as event handler so that it is called from the commit actions on Ticket. This ensures the ticket''s chunks are always being updated in the knowledge base as well.', position: (424, -100), size: (390, 120))
  @start(64, 180)
  @position(204, 180)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $TicketList from ExampleMicroflows.Ticket;
  @position(394, 180)
  @curve(from: (30, 0), to: (-30, 0))
  $ChunkCollection = call microflow GenAICommons.ChunkCollection_Create();
  @position(1265, 180)
  @annotation(text: 'The activities inside the loop are identical to BCo_Ticket. It is shown here for clarity.
In implementations, a sub-microflow can be used to prevent duplication of code.', position: (1265, -119), size: (460, 70))
  loop $IteratorTicket in $TicketList
  begin
    @position(150, 115)
    $MetadataCollection = call microflow GenAICommons.MetadataCollection_CreateAndAddMetadata(Key = 'Status', Value = if $IteratorTicket/Status != empty then
  getKey($IteratorTicket/Status)
else
  '');
    @position(332, 115)
    call microflow GenAICommons.MetadataCollection_AddMetadata(Key = 'Category', Value = if $IteratorTicket/Category != empty then
  getKey($IteratorTicket/Category)
else 
  '', MetadataCollection = $MetadataCollection);
    @position(507, 115)
    @merge(857, 115)
    @caption 'Solution?'
    if trim($IteratorTicket/Solution) != '' then
      @position(682, 115)
      @annotation(text: 'Pass (optionally) a "knowledge" meta data to the chunk. This is being used as return value to the model, so that the model can base the response on different values than the InputText of the chunk.
', position: (1207, -5), size: (320, 100))
      call microflow GenAICommons.MetadataCollection_AddMetadata(Key = 'knowledge', Value = $IteratorTicket/Solution, MetadataCollection = $MetadataCollection);
    end if;
    @position(1032, 115)
    @annotation(text: 'Pass (optionally) a sourceUrl to the chunk that is added to the references (and displayed in ConversationalUI).
For Mendix Objects, you can also pass a deeplink if applicable.', position: (1557, -5), size: (320, 90))
    call microflow GenAICommons.MetadataCollection_AddMetadata(Key = 'sourceUrl', Value = 'https://www.mendix.com/', MetadataCollection = $MetadataCollection);
    @position(1222, 115)
    declare $InputText String = 'Subject: ' + $IteratorTicket/Subject +' 
Description: ' + $IteratorTicket/Description +
(
if trim($IteratorTicket/ReproductionSteps) != '' then 
  '
Reproduction steps: '+ $IteratorTicket/ReproductionSteps
else 
  '' 
);
    @position(1412, 115)
    call java action GenAICommons.ChunkCollection_AddKnowledgeBaseChunk(ChunkCollection = $ChunkCollection, InputText = $InputText, HumanReadableID = 'Ticket '+$IteratorTicket/Identifier, EntityType = 'ExampleMicroflows.Ticket', MxObject = $IteratorTicket, MetadataCollection = $MetadataCollection);
  end loop;
  @position(2165, 180)
  @curve(to: (-30, 0))
  @annotation(id: n1, text: 'Get a Collection to be used for knowledge base retrieval registration. Customize to your own logic to retrieve the right knowledge base resource(s).', position: (2256, 25), size: (200, 90))
  retrieve $MxCloudKnowledgeBaseResource from MxGenAIConnector.MxCloudKnowledgeBaseResource
    first;
  @position(2355, 180)
  @annotation(id: n1)
  $DeployedKnowledgeBase = call microflow MxGenAIConnector.Collection_GetCreate(MxCloudKnowledgeBaseResource = $MxCloudKnowledgeBaseResource, CollectionName = 'HistoricalTickets');
  @position(2545, 180)
  @curve(from: (30, 0), to: (-15, 0))
  call microflow MxGenAIConnector.ChunkCollection_Embed_Replace(ChunkCollection = $ChunkCollection, DeployedKnowledgeBase = $DeployedKnowledgeBase);
  @position(2668, 180)
  return;
end;

create or modify microflow ExampleMicroflows.BCo_Ticket (
  @position(585, 95)
  $Ticket: ExampleMicroflows.Ticket
)
returns Boolean
folder 'Ground in data - Mendix Cloud/Sync Mendix app data'
begin
  @annotation(text: 'This microflow is set as event handler so that it is called from the commit actions on Ticket. This ensures the ticket''s chunks are always being updated in the knowledge base as well.
Compare with logic from ACT_TicketList_LoadAllIntoKnowledgeBase which should be the same to create a chunk for the knowledge base.', position: (760, -80), size: (390, 120))
  @start(585, 180)
  @position(735, 180)
  @curve(from: (30, 0), to: (-30, 0))
  $ChunkCollection = call microflow GenAICommons.ChunkCollection_Create();
  @position(920, 180)
  @curve(from: (30, 0), to: (-30, 0))
  $MetadataCollection = call microflow GenAICommons.MetadataCollection_CreateAndAddMetadata(Key = 'Category', Value = if $Ticket/Category != empty then
  getKey($Ticket/Category)
else 
  '');
  @position(1110, 180)
  @curve(from: (30, 0), to: (-15, 0))
  call microflow GenAICommons.MetadataCollection_AddMetadata(Key = 'Status', Value = if $Ticket/Status != empty then
  getKey($Ticket/Status)
else
  '', MetadataCollection = $MetadataCollection);
  @position(1285, 180)
  @merge(1635, 180)
  @caption 'Solution?'
  if trim($Ticket/Solution) != '' then
    @position(1460, 180)
    @curve(from: (30, 0), to: (-15, 0))
    call microflow GenAICommons.MetadataCollection_AddMetadata(Key = 'knowledge', Value = $Ticket/Solution, MetadataCollection = $MetadataCollection);
  end if;
  @position(1815, 180)
