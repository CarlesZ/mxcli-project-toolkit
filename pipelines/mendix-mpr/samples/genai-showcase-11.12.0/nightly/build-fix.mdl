create or modify microflow AgentEditorCommons.DeployedModel_CreateUpdate_List (
  @position(72, 125)
  $ModelDocumentList: List of AgentEditorCommons.ModelDocument
)
returns Boolean as $IsSuccess
folder 'Private/UsedByJava'
begin
  @start(72, 302)
  @position(225, 302)
  $AllValid = call microflow AgentEditorCommons.ModelDocument_ValidateList(ModelDocumentList = $ModelDocumentList);
  @position(380, 302)
  @caption 'all valid?'
  if $AllValid then
    @position(555, 302)
    @curve(from: (30, 0), to: (-30, 0))
    declare $AllSuccess Boolean = true;
    @position(745, 302)
    $DeployedModelList_ToKeep = create list of GenAICommons.DeployedModel;
    @position(1154, 302)
    loop $IteratorModelDocument in $ModelDocumentList
    begin
      @position(149, 96)
      $IsSuccess = call microflow AgentEditorCommons.DeployedModel_CreateUpdate(DocumentContent = $IteratorModelDocument/Content, QualifiedName = $IteratorModelDocument/QualifiedName, DocumentID = $IteratorModelDocument/DocumentID, DeployedModelList_ToKeep = $DeployedModelList_ToKeep);
      @position(332, 96)
      @caption 'succes?'
      if $IsSuccess then
        @position(456, 96)
        continue;
      else
        @position(332, 214)
        @anchor(to: top)
        set $AllSuccess = false;
        @position(456, 214)
        break;
      end if;
    end loop;
    @position(1553, 302)
    @caption 'all success?'
    if $AllSuccess then
      @position(1728, 302)
      @curve(from: (30, 0), to: (-30, 0))
      retrieve $DeployedModelList_FromModel from GenAICommons.DeployedModel
    where [ModelDocumentID != empty]
    [OutputModality = GenAICommons.ENUM_ModelModality.Text];
      @position(1918, 302)
      @curve(from: (30, 0), to: (-30, 0))
      $DeployedModelList_ToDelete = subtract $DeployedModelList_ToKeep from $DeployedModelList_FromModel;
      @position(2108, 302)
      $Count_ToDelete = count $DeployedModelList_ToDelete;
      @position(2298, 302)
      @curve(from: (30, 0), to: (-30, 0))
      delete $DeployedModelList_ToDelete;
      @position(2488, 302)
      log node @AgentEditorCommons.LogNode 'DeployedModel_CreateUpdate_List: Deleted {1} DeployedModel record(s).' with ({1} = $Count_ToDelete + '');
      @position(2628, 302)
      return true;
    else
      @position(1553, 386)
      @anchor(to: top)
      return false;
    end if;
  else
    @position(380, 419)
    @anchor(to: top)
    return false;
  end if;
end;

