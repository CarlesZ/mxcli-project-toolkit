                    )
                    image image12 (
                      Image: 'ConversationalUI.Image_Traces.bedrock',
                      Class: 'unset-img-width ',
                      Visible: contains($currentObject/Architecture,'Bedrock')
                    )
                    image image13 (
                      Image: 'ConversationalUI.Image_Traces.azure_outline',
                      Class: 'unset-img-width ',
                      Visible: contains($currentObject/Architecture,'Azure')
                    )
                    image image9 (
                      Image: 'ConversationalUI.Image_Traces.cloud_sparkle',
                      Class: 'unset-img-width ',
                      Visible: contains($currentObject/Architecture,'Mendix')
                    )
                    image image15 (
                      Image: 'ConversationalUI.Image_Traces.Mistral',
                      Class: 'unset-img-width ',
                      Visible: contains($currentObject/Architecture,'Mistral')
                    )
                  }
                  dynamictext text80 (Content: '{1}', ContentParams: ({1} = DeployedModelDisplayName))
                }
              }
            }
            container container72 (
              Class: 'tooltip-col',
              Visible: $currentObject/NrOfMCPCalls != 0 or $currentObject/NrOfToolCalls!= 0
            ) {
              dynamictext text78 (Content: 'Tools
', Class: 'font-weight-semibold')
            }
            container container1 (
              Class: 'tooltip-col',
              Visible: $currentObject/NrOfMCPCalls != 0 or $currentObject/NrOfToolCalls!= 0
            ) {
              listview listView1 (
                DataSource: database from $Version/AgentCommons.Tool_Version/AgentCommons.Tool,
                PageSize: 10,
                Class: 'listview-custom-spacing listview-hide-on-empty listview-remove-spacing listview-stylingless'
              ) {
                -- Context: $currentObject (AgentCommons.Tool), $listView1 (selection)
                container container30 (Class: 'row-text-img') {
                  image image7 (
                    Image: 'ConversationalUI.Image_Traces.microflow',
                    WidthUnit: pixels,
                    Width: 24,
                    Class: 'img--20-20'
                  )
                  dynamictext text79 (
                    Content: '{1}',
                    ContentParams: ({1} = Name),
                    Class: 'text-clamp--1-line spacing-outer-left-smallest'
                  )
                }
                template for AgentCommons.MCP {
                  container container36 (Class: 'row-text-img') {
                    image image8 (
                      Image: 'ConversationalUI.Image_Traces.MCP',
                      WidthUnit: pixels,
                      Width: 24,
                      Class: 'img--20-20'
                    )
                    dynamictext text85 (
                      Content: '{1}',
                      ContentParams: ({1} = Name),
                      Class: 'text-clamp--1-line spacing-outer-left-smallest'
                    )
                  }
                }
                template for AgentCommons.SingleMCPTool {
                  container container37 (Class: 'row-text-img') {
                    image image11 (
                      Image: 'ConversationalUI.Image_Traces.wrench',
