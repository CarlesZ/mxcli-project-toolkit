  $NewSource = create ConversationalUI.Source (Title = $Reference/Title, Content = $Reference/Content, Source = replaceFirst(
$Reference/Source,
'id/'+$id,
'id/'+toString($GUID)));
  @position(750, 200)
  @curve(from: (30, 0), to: (-15, 0))
  show page ConversationalUI.Source_View(Source = $NewSource);
  @position(1005, 200)
  return;
end;

