};

create or modify snippet AgentCommons.Snippet_Output_List folder 'Private/Resources/Snippets/Output' (Params: ( $PageHelper: AgentCommons.PageHelper )) {
  dataview dataView1 (
    DataSource: microflow AgentCommons.DS_PageHelper_GetFirstTestRun(PageHelper = $PageHelper),
    ShowFooter: true,
