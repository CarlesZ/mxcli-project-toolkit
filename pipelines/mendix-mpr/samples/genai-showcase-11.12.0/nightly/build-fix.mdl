To continue, please go back to the previous tab and validate your KnowledgeBaseID.' type Information blocking;
    @position(-416, 205)
    @anchor(to: top)
    return false;
  end if;
end;

create or modify page AgentCommons.Version_NewEdit folder 'Private/Pages/Version' (
  Title: 'Edit agent version',
  Layout: Atlas_Core.PopupLayout,
  PopupResizable: true,
  PopupCloseAction: actionButton2,
  Params: ( $Version: AgentCommons.Version, $PageHelper: AgentCommons.PageHelper, $Version_Draft: AgentCommons.Version, $Agent: AgentCommons.Agent )
) {
  dataview dataView1 (DataSource: $Version, FormOrientation: Vertical, ReadOnlyStyle: Control) {
    -- Context: $currentObject (Version)
    layoutgrid layoutGrid1 {
      row {
        column (DesktopWidth: AutoFill) {
          textbox textBox1 (Label: 'Title', Attribute: Title)
        }
      }
      row {
        column (DesktopWidth: AutoFill) {
          textarea textArea1 (Label: 'Description', Attribute: Description)
        }
      }
      row {
        column (DesktopWidth: AutoFill) {
          dataview dataView3 (
            DataSource: $Agent,
            FormOrientation: Vertical,
            ShowFooter: true,
            ReadOnlyStyle: Control
          ) {
            -- Context: $currentObject (Agent)
            combobox comboBox3 (
              Label: 'Check Agent Version In Use (change if necessary)',
              Attribute: AgentCommons.Agent_Version_InUse,
              DataSource: $Agent/AgentCommons.Version_Agent,
              optionsSourceAssociationCaptionType: expression,
              optionsSourceAssociationCaptionExpression: '''v'' + $currentObject/VersionNumber + '' '' + $currentObject/Title',
              Class: 'combobox-selection'
            )
          }
        }
      }
    }
    footer {
      container container3 (DesignProperties: ('Align content (deprecated)': 'Right align as a row')) {
        actionbutton actionButton1 (
          Caption: 'Save',
          Action: call microflow AgentCommons.ACT_Version_Save(PageHelper = $PageHelper, Version_Draft = $Version_Draft, Agent = $Agent) with (ProgressBar: Blocking, ProgressMessage: 'Saving..'),
          ButtonStyle: Primary,
          DesignProperties: ('Align self': 'Right', 'Spacing': ('margin-right': 'S'))
        )
        actionbutton actionButton2 (
          Caption: 'Cancel',
          Action: cancel changes close page,
          DesignProperties: ('Align self': 'Right')
        )
      }
    }
  }
};

create or modify page AgentCommons.Version_Overview folder 'Private/Pages/Version' (
  Title: 'Manage versions',
  Layout: Atlas_Core.PopupLayout,
  PopupResizable: true,
  PopupCloseAction: actionButton2,
  Class: 'agent-popup-midsize',
  Params: ( $Agent: AgentCommons.Agent, $PageHelper: AgentCommons.PageHelper, $Version_InUse_Current: AgentCommons.Version )
) {
  dataview dataView1 (DataSource: $Agent, FormOrientation: Vertical, ReadOnlyStyle: Control) {
    -- Context: $currentObject (Agent)
    layoutgrid layoutGrid1 {
      row {
        column (DesktopWidth: AutoFill) {
          container container3 (DesignProperties: ('Spacing': ('margin-bottom': 'M'))) {
            dynamictext text3 (
              Content: 'Select the version you want to use from the options below.',
              DesignProperties: ('Color': 'Detail color')
            )
          }
        }
      }
      row (VerticalAlignment: End) {
        column (DesktopWidth: 6, TabletWidth: 12, PhoneWidth: 12) {
          dataview dataView2 (
            DataSource: $Version_InUse_Current,
            FormOrientation: Vertical,
            ShowFooter: true,
            ReadOnlyStyle: Control,
            Class: 'width--40-percent/'
          ) {
            -- Context: $currentObject (Version_InUse_Current)
            container container4 (DesignProperties: ('Align content (deprecated)': 'Left align as a row')) {
              snippetcall snippetCall1 (
                Snippet: AgentCommons.Snippet_Agent_SelectVersion,
                Params: (Agent = $Agent, Version_InUse_Current = $Version_InUse_Current),
                DesignProperties: ('Spacing': ('margin-right': 'S'))
              )
              actionbutton actionButton5 (
                Caption: 'Save',
                Action: call microflow AgentCommons.ACT_Agent_SelectInUseVersion_Reopen(PageHelper = $PageHelper),
                ButtonStyle: Primary,
                Class: 'align-self-end',
                DesignProperties: ('Spacing': ('margin-left': 'M'))
              )
            }
          }
        }
        column (DesktopWidth: AutoFit, TabletWidth: AutoFit, PhoneWidth: AutoFit) {
        }
      }
      row {
        column (DesktopWidth: AutoFill) {
          container container43 (Class: 'version-table agent-table-header') {
            dynamictext text51 (
              Content: 'Version',
              Class: 'version-grid-item',
              DesignProperties: ('Weight': 'Semibold')
            )
            dynamictext text52 (Content: 'Title', Class: 'text-title', DesignProperties: ('Weight': 'Semibold'))
            dynamictext text53 (Content: 'In use', Class: 'text-in-use', DesignProperties: ('Weight': 'Semibold'))
            dynamictext text54 (Content: 'Owner', Class: 'version-grid-item', DesignProperties: ('Weight': 'Semibold'))
            dynamictext text58 (
              Content: 'Last edited by',
              Class: 'version-grid-item',
              DesignProperties: ('Weight': 'Semibold')
            )
            dynamictext text55 (
              Content: 'Last edited',
              Class: 'version-grid-item',
              DesignProperties: ('Weight': 'Semibold')
            )
          }
          listview listView3 (
            DataSource: database from AgentCommons.Version where [AgentCommons.Version_Agent = $currentObject] [not(IsDraftVersion)],
            PageSize: 10,
            DesignProperties: ('Style': 'No styling')
          ) {
            -- Context: $currentObject (AgentCommons.Version), $listView3 (selection)
            container container48 (Class: 'version-table', DesignProperties: ('Spacing': ('margin-top': 'M'))) {
              dynamictext text56 (
                Content: 'v{1}',
                ContentParams: ({1} = VersionNumber),
                Class: 'version-grid-item',
                DesignProperties: ('Weight': 'Semibold')
              )
              dynamictext text57 (Content: '{1}', ContentParams: ({1} = Title), Class: 'version-grid-item')
              container container6 (Class: 'version-grid-item') {
                dynamictext text1 (Content: ' ', Visible: $Version_InUse_Current != $currentObject)
                container container1 (Visible: $Version_InUse_Current = $currentObject) {
                  container container2 (Class: 'badge--in-use') {
                    dynamictext text2 (Content: 'In use', Class: 'badge-text', DesignProperties: ('Size': 'Small'))
                  }
                }
              }
              dynamictext text59 (Content: '{1}', ContentParams: ({1} = VersionOwner), Class: 'version-grid-item')
              dynamictext text60 (Content: '{1}', ContentParams: ({1} = LastChangedBy), Class: 'version-grid-item')
              dynamictext text61 (
                Content: '{1}',
                ContentParams: ({1} = VersionChangedDate format (dateFormat: DateTime)),
                Class: 'version-grid-item'
              )
              container container5 (Class: 'version-grid-item') {
                linkbutton actionButton1 (
                  Action: call microflow AgentCommons.ACT_Version_Delete(PageHelper = $PageHelper) with (Confirmation: 'Are you sure?', ProceedCaption: 'Proceed', CancelCaption: 'Cancel'),
                  Icon: glyph 57376,
                  Class: 'delete-icon',
                  Visible: $dataView1/AgentCommons.Agent_Version_InUse != $currentObject
                )
                linkbutton actionButton3 (
                  Action: call microflow AgentCommons.ACT_DoNothing,
                  Icon: glyph 57376,
                  Class: 'delete-icon disabled',
                  Visible: $dataView1/AgentCommons.Agent_Version_InUse = $currentObject
                )
              }
            }
          }
        }
      }
    }
    footer {
      actionbutton actionButton2 (
        Caption: 'Close',
        Action: close page,
        ButtonStyle: Primary,
        DesignProperties: ('Align self': 'Right')
      )
    }
  }
};

create or modify page ChatCompletions_ProductDescription.ProductDescriptionShowcase_Step2_Generate folder 'Studio Pro Agent/Pages/Step2_Generate' (
  Title: 'Product Description Generate',
  Layout: Atlas_Core.Atlas_Default,
  PopupResizable: true,
  Params: ( $DescriptionSuggestion: ChatCompletions_ProductDescription.ObjectDescription )
) {
  container container8 (Class: 'convui-pagecontainer') {
    dataview dataView1 (
      DataSource: $DescriptionSuggestion,
      FormOrientation: Vertical,
      ShowFooter: true,
      ReadOnlyStyle: Control
    ) {
      -- Context: $currentObject (DescriptionSuggestion)
      layoutgrid layoutGrid2 {
        row {
          column (DesktopWidth: AutoFill) {
            container container20 (
              Class: 'wizard wizard-circle',
              DesignProperties: ('Spacing': ('margin-bottom': 'L'))
            ) {
              container container26 (Class: 'wizard-step') {
                actionbutton actionButton13 (
                  Caption: '1',
                  Action: show page ChatCompletions_ProductDescription.ProductDescriptionShowcase_Step1_Introduction,
                  Class: 'wizard-step-number'
                )
                linkbutton actionButton18 (
                  Caption: 'Introduction',
                  Action: show page ChatCompletions_ProductDescription.ProductDescriptionShowcase_Step1_Introduction,
                  Class: 'wizard-step-text',
                  DesignProperties: ('Spacing': ('margin-top': 'S'))
                )
              }
              container container23 (Class: 'wizard-step wizard-step-active') {
                actionbutton actionButton9 (
                  Caption: '2',
                  Action: call microflow General.ACT_DoNothing with (ProgressBar: Blocking, ProgressMessage: ''),
                  Class: 'wizard-step-number'
                )
                linkbutton actionButton16 (
                  Caption: 'Generate Product Description',
                  Action: call microflow General.ACT_DoNothing with (ProgressBar: Blocking, ProgressMessage: ''),
                  Class: 'wizard-step-text',
                  DesignProperties: ('Spacing': ('margin-top': 'S'))
                )
              }
            }
            container container2 {
              layoutgrid layoutGrid3 {
                row (Class: 'spacing-inner-bottom-none') {
                  column (DesktopWidth: AutoFill) {
                    container container10 (
                      Class: 'alert alert-primary spacing-inner-top-medium spacing-inner-bottom-medium spacing-inner-left-medium spacing-inner-right-medium spacing-outer-top-large  spacing-outer-bottom-medium'
                    ) {
                      layoutgrid layoutGrid11 {
                        row {
                          column (
                            DesktopWidth: AutoFit,
                            TabletWidth: AutoFit,
                            PhoneWidth: AutoFit,
                            VerticalAlignment: Start
                          ) {
                          }
                          column (DesktopWidth: AutoFill, VerticalAlignment: Center) {
                            dynamictext text27 (
                              Content: 'Info',
                              RenderMode: H5,
                              Class: 'alert-title',
                              DesignProperties: ('Weight': 'Bold', 'Spacing': ('margin-bottom': 'None'))
                            )
                            dynamictext text30 (
                              Content: 'Here, you can use a preconfigured agent to test the example. The default agent "Agent_ProductDescriptionGenerator" is preconfigured specifically for this example. You can test different data for the input fields and experience how the outcome will change. Alternatively, you can test the agent in the agent''s playground in Studio Pro.',
                              RenderMode: Paragraph,
                              ContentParams: ({1} = toString(@Embeddings_RAG.NumberOfChunksUsed)),
                              Class: 'alert-description',
                              DesignProperties: ('Spacing': ('margin-bottom': 'None'))
                            )
                            dynamictext text28 (
                              Content: 'Note:',
                              RenderMode: H5,
                              Class: 'alert-title',
                              DesignProperties: ('Weight': 'Bold', 'Spacing': ('margin-bottom': 'None'))
                            )
                            dynamictext text31 (
                              Content: 'This example primarily works with the default agent that is initially provided ("Agent_ProductDescriptionGenerator"). If there are changes made to this agent, the example might not work as expected.',
                              RenderMode: Paragraph,
                              ContentParams: ({1} = toString(@Embeddings_RAG.NumberOfChunksUsed)),
                              Class: 'alert-description',
                              DesignProperties: ('Spacing': ('margin-bottom': 'None'))
                            )
                          }
                        }
                      }
                    }
                  }
                }
              }
              layoutgrid layoutGrid1 (Class: 'spacing-inner-none') {
                row (Class: 'spacing-inner-bottom-medium') {
                  column (DesktopWidth: AutoFill) {
                    container container6 (Class: 'card height--95', DesignProperties: ('Shadow': 'Small')) {
                      dynamictext text10 (
                        Content: 'User Input: Provide details about your product',
                        RenderMode: H5,
                        DesignProperties: ('Spacing': ('margin-bottom': 'M'))
                      )
                      textbox textBox1 (
                        Label: 'Object Name *',
                        Attribute: ObjectName,
                        SubmitBehaviour: WhileEditing,
                        SubmitOnInputDelay: 800
                      )
                      layoutgrid layoutGrid4 {
                        row {
                          column (DesktopWidth: AutoFill) {
                            textbox textBox4 (
                              Label: 'Number of words *',
                              Attribute: NumberOfWords,
                              SubmitBehaviour: WhileEditing,
                              SubmitOnInputDelay: 800
                            )
                          }
                          column (DesktopWidth: AutoFill) {
                            combobox dropDown2 (Label: 'Tone of voice *', Attribute: ToneOfVoice)
                          }
                        }
                        row {
                          column (DesktopWidth: AutoFill) {
                            container container12 (
                              Class: 'form-group',
                              DesignProperties: ('Spacing': ('margin-bottom': 'None'))
                            ) {
                              dynamictext text2 (Content: 'Keywords *', Class: 'control-label')
                            }
                            listview listView2 (
                              DataSource: $currentObject/ChatCompletions_ProductDescription.Keyword_ObjectDescription,
                              PageSize: 10,
                              Editable: true,
                              Class: 'listview-horizontal',
                              DesignProperties: ('Style': 'No styling')
                            ) {
                              -- Context: $currentObject (ChatCompletions_ProductDescription.Keyword_ObjectDescription), $listView2 (selection)
                              container container3 (
                                Class: 'product-tag spacing-outer-bottom container-border-primary',
                                DesignProperties: ('Spacing': ('padding-top': 'S', 'padding-bottom': 'S', 'padding-left': 'S', 'margin-right': 'S'), 'Align content (deprecated)': 'Left align as a row')
                              ) {
                                textbox textBox5 (
                                  Attribute: KeywordString,
                                  OnChange: call microflow ChatCompletions_ProductDescription.OCh_Keyword_CreateBlank,
                                  SubmitBehaviour: WhileEditing,
                                  SubmitOnInputDelay: 800,
                                  DesignProperties: ('Spacing': ('margin-bottom': 'None', 'margin-right': 'S'))
                                )
                                actionbutton actionButton8 (
                                  Action: call microflow ChatCompletions_ProductDescription.ACT_Keyword_Remove,
                                  Icon: glyph 57364,
                                  Class: 'btn-image',
                                  DesignProperties: ('Spacing': ('margin-right': 'M'))
                                )
                              }
                            }
                          }
                        }
                      }
                      actionbutton actionButton6 (
                        Caption: 'Generate description',
                        Action: call microflow ChatCompletions_ProductDescription.ACT_ObjectDescription_Generate with (ProgressBar: Blocking, ProgressMessage: '', Asynchronous: true),
                        ButtonStyle: Primary,
                        DesignProperties: ('Align self': 'Right')
                      )
                    }
                  }
                  column (DesktopWidth: AutoFill) {
                    container container7 (Class: 'card height--95', DesignProperties: ('Shadow': 'Small')) {
                      dynamictext text13 (
                        Content: 'Review suggestion',
                        RenderMode: H5,
                        DesignProperties: ('Spacing': ('margin-bottom': 'M'))
                      )
                      dataview dataView9 (
                        DataSource: microflow ChatCompletions_ProductDescription.DS_ObjectDescription_GetOrCreateSuggestedDescription,
                        FormOrientation: Vertical,
                        ShowFooter: true,
                        ReadOnlyStyle: Control
                      ) {
                        -- Context: $currentObject (ChatCompletions_ProductDescription.SuggestedDescription)
                        container container9 (
                          Class: 'container-clickable',
                          Visible: trim($currentObject/AssistantResponse) != '',
                          Action: call nanoflow ChatCompletions_ProductDescription.ACT_SuggestedDescription_Copy
                        ) {
                          dynamictext text1 (
                            Content: '{1}',
                            RenderMode: Paragraph,
                            ContentParams: ({1} = AssistantResponse)
                          )
                          container container11 (Class: 'btn-wrapper') {
                            actionbutton actionButton2 (
                              Tooltip: 'Copy to clipboard',
                              Action: call nanoflow ChatCompletions_ProductDescription.ACT_SuggestedDescription_Copy,
                              Icon: image 'General.Image_collection.copy_duplicate',
                              Class: 'btn-hover',
                              Visible: ShowCheckmark in (false)
                            )
                            actionbutton actionButton4 (
                              Caption: 'copied!',
                              Tooltip: 'Copy to clipboard',
                              Action: call nanoflow ChatCompletions_ProductDescription.ACT_SuggestedDescription_Copy,
                              Class: 'btn-hover text-small',
                              Visible: ShowCheckmark in (true)
                            )
                          }
                        }
                        actionbutton actionButton10 (
                          Caption: 'Regenerate description',
                          Action: call microflow ChatCompletions_ProductDescription.ACT_ObjectDescription_Generate with (ProgressBar: Blocking, ProgressMessage: '', Asynchronous: true),
                          Icon: glyph 57392,
                          DesignProperties: ('Spacing': ('margin-right': 'M', 'margin-bottom': 'M', 'margin-top': 'M'), 'Align self': 'Right'),
                          Visible: trim($currentObject/AssistantResponse) != ''
                        )
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};

create or modify snippet AgentCommons.Snippet_OutputInfo folder 'Private/Resources/Snippets/Output' (Params: ( $PageHelper: AgentCommons.PageHelper )) {
  container container30 (
    Class: 'alert alert-primary',
    DesignProperties: ('Spacing': ('padding-top': 'M', 'padding-left': 'M', 'padding-right': 'M', 'margin-bottom': 'None')),
    Visible: $PageHelper.IsTestRunSuccessful in (true)
  ) {
    layoutgrid layoutGrid12 (
      DesignProperties: ('Spacing': ('padding-top': 'None', 'padding-bottom': 'None', 'padding-left': 'None', 'padding-right': 'None'))
    ) {
      row {
        column (DesktopWidth: AutoFit, TabletWidth: AutoFit, PhoneWidth: AutoFit, VerticalAlignment: Start) {
        }
        column (DesktopWidth: AutoFill, VerticalAlignment: Center) {
          container container27 {
            dynamictext text16 (Content: 'Generate output: ', DesignProperties: ('Weight': 'Semibold'))
            dynamictext text31 (
              Content: 'select a model and run the prompt to generate the output. You can also run the prompt against multiple test cases to get a comprehensive output table for easy analysis and comparison.',
              Class: 'alert-description',
              DesignProperties: ('Spacing': ('margin-bottom': 'None'))
            )
          }
        }
      }
    }
  }
  snippetcall snippetCall1 (Snippet: AgentCommons.Snippet_TestError, Params: (PageHelper = $PageHelper))
};

create or modify snippet ConversationalUI.Snippet_Message_Content folder 'Private/Conversational UI/Resources/Snippets' (Params: ( $Message: ConversationalUI.Message )) {
  container container1 {
    listview listView1 (
      DataSource: database from $Message/ConversationalUI.SubMessage_Message/ConversationalUI.SubMessage sort by createdDate asc,
      PageSize: 10,
      Class: 'listview-hide-on-empty listview-remove-spacing'
    ) {
      -- Context: $currentObject (ConversationalUI.SubMessage), $listView1 (selection)
      dynamictext text2 (Content: '{1}', ContentParams: ({1} = Content))
      template for ConversationalUI.ToolMessage {
        container container6 (Class: 'tool-message', Visible: ToolCallStatus in (Pending)) {
          container container7 (
            Class: 'tool-title',
            DesignProperties: ('Align content (deprecated)': 'Left align as a row')
          ) {
            dynamictext text15 (Content: '{1}', ContentParams: ({1} = Title))
          }
          container container15 (Class: 'tool-details', Visible: ToolCallStatus in (Pending)) {
            dynamictext text14 (Content: '{1}', RenderMode: Paragraph, ContentParams: ({1} = Description))
            container container16 (DesignProperties: ('Align content (deprecated)': 'Right align as a row')) {
              actionbutton actionButton4 (
                Caption: 'Reject',
                Action: call nanoflow ConversationalUI.ACT_ToolMessage_Decline,
                Class: 'reject-button btn-small'
              )
              actionbutton actionButton3 (
                Caption: 'Confirm',
                Action: call nanoflow ConversationalUI.ACT_ToolMessage_Approve,
                ButtonStyle: Primary,
                Class: 'btn-small',
                DesignProperties: ('Spacing': ('margin-left': 'S'))
              )
            }
          }
        }
        accordion accordion1 (
          advancedMode: false,
          collapsible: true,
          expandBehavior: 'singleExpanded',
          animate: true,
          showIcon: 'left',
          animateIcon: true,
          Class: 'accordion-tool-calls',
          Visible: ToolCallStatus in (Approved, Declined, ExecutedApproved, ExecutedDeclined, ExecutedVisible)
        ) {
          group (
            headerRenderMode: 'custom',
            headerHeading: 'headingThree',
            visible: 'true',
            loadContent: 'always',
            initialCollapsedState: 'collapsed',
            initiallyCollapsed: 'true'
          ) {
            layoutgrid layoutGrid1 {
              row (VerticalAlignment: Center) {
                column (
                  DesktopWidth: AutoFit,
                  TabletWidth: AutoFit,
                  PhoneWidth: AutoFit,
                  Class: 'spacing-inner-none'
                ) {
                }
                column (DesktopWidth: AutoFill) {
                  container container3 (DesignProperties: ('Align content (deprecated)': 'Left align as a row')) {
                    dynamictext text10 (
                      Content: '{1}',
                      ContentParams: ({1} = Title),
                      Class: 'tool-title',
                      DesignProperties: ('Spacing': ('margin-right': 'S'))
                    )
                    container container4 (
                      Class: 'spinner',
                      DesignProperties: ('Spacing': ('margin-right': 'S')),
                      Visible: $currentObject/ToolCallStatus = GenAICommons.ENUM_ToolCallStatus.Approved and
$currentObject/ToolCallStatus != GenAICommons.ENUM_ToolCallStatus.ExecutedApproved
                    )
                    image image6 (
                      Image: 'ConversationalUI.Image_collection.accept',
                      Class: 'tool-status-image',
                      DesignProperties: ('Spacing': ('margin-right': 'S')),
                      Visible: ($currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedApproved
or $currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedVisible)
and $currentObject/IsError = false
                    )
                    image image7 (
                      Image: 'ConversationalUI.Image_collection.reject',
                      Class: 'tool-status-image',
                      DesignProperties: ('Spacing': ('margin-right': 'S')),
                      Visible: ($currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedApproved
or $currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedVisible)
and
$currentObject/IsError = true
                    )
                  }
                }
              }
            }
            container container12 (
              Class: 'card',
              DesignProperties: ('Align content (deprecated)': 'Left align as a row'),
              Visible: ($currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.Approved 
or $currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedApproved)
and $currentObject/IsError = false
            ) {
              dynamictext text11 (
                Content: 'You approved the tool call, and it was successful.',
                ContentParams: ({1} = Title)
              )
            }
            container container13 (
              Class: 'card',
              DesignProperties: ('Align content (deprecated)': 'Left align as a row'),
              Visible: ToolCallStatus in (Declined, ExecutedDeclined)
            ) {
              dynamictext text12 (
                Content: 'You rejected the tool call.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (Function, "MCP")
              )
              dynamictext text17 (
                Content: 'You rejected the tool call.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (KnowledgeBaseRetrieval)
              )
            }
            container container19 (
              Class: 'card',
              DesignProperties: ('Align content (deprecated)': 'Left align as a row'),
              Visible: $currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedApproved
and $currentObject/IsError
            ) {
              dynamictext text20 (
                Content: 'You approved the tool call, but it failed.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (Function, "MCP")
              )
              dynamictext text23 (
                Content: 'You approved the tool call, but it failed.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (KnowledgeBaseRetrieval)
              )
            }
            container container20 (
              Class: 'card',
              DesignProperties: ('Align content (deprecated)': 'Left align as a row'),
              Visible: $currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedVisible
and $currentObject/IsError = false
            ) {
              dynamictext text21 (
                Content: 'Knowledge Base call was successful.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (KnowledgeBaseRetrieval)
              )
              dynamictext text22 (
                Content: 'Tool call was successful.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (Function, "MCP")
              )
            }
            container container14 (
              Class: 'card',
              DesignProperties: ('Align content (deprecated)': 'Left align as a row'),
              Visible: $currentObject/ToolCallStatus=GenAICommons.ENUM_ToolCallStatus.ExecutedVisible
and $currentObject/IsError
            ) {
              dynamictext text13 (
                Content: 'Tool call failed.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (Function, "MCP")
              )
              dynamictext text18 (
                Content: 'Knowledge Base call failed.',
                ContentParams: ({1} = Title),
                Visible: InternalToolType in (KnowledgeBaseRetrieval)
              )
            }
          }
        }
      }
    }
    container container2 (
      Class: 'spacing-inner-bottom-small',
      Visible: $Message/Role=GenAICommons.ENUM_MessageRole.user
or @ConversationalUI.EnableMarkdownViewer = false
    ) {
      dynamictext text8 (Content: '{1}', ContentParams: ({1} = $Message.Content))
    }
    dataview dvMessageContent (DataSource: $Message, ReadOnlyStyle: Control) {
      -- Context: $currentObject (Message)
      markdown markdownViewer1 (
        stringAttribute: Content,
        Class: 'chat-listview-stylingless',
        DesignProperties: ('Spacing': ('margin-bottom': 'None')),
        Visible: $Message/Role=GenAICommons.ENUM_MessageRole.assistant
  and @ConversationalUI.EnableMarkdownViewer
  and trim($Message/Content) != ''
      )
    }
  }
};

create or modify snippet ConversationalUI.Snippet_Message_Sources folder 'Private/Conversational UI/Resources/Snippets' (Params: ( $Message: ConversationalUI.Message )) {
  accordion accordion1 (
    advancedMode: false,
    collapsible: true,
    expandBehavior: 'singleExpanded',
    animate: true,
    showIcon: 'left',
    animateIcon: true,
    Class: 'accordion-chat-sources',
    DesignProperties: ('Borders': 'None', 'Spacing': ('margin-top': 'S', 'margin-bottom': 'S')),
    Visible: $Message/Role = GenAICommons.ENUM_MessageRole.assistant
and trim($Message/Content) != ''
and $Message/HasSources
  ) {
    group (
      headerRenderMode: 'custom',
      headerHeading: 'headingThree',
      visible: 'true',
      loadContent: 'whenExpanded',
      initialCollapsedState: 'expanded',
      initiallyCollapsed: 'true',
      onToggleCollapsed: call microflow ConversationalUI.ACT_DoNothing
    ) {
      layoutgrid layoutGrid2 {
        row (VerticalAlignment: Center) {
          column (DesktopWidth: AutoFill) {
            dynamictext text1 (Content: 'References', DesignProperties: ('Spacing': ('margin-bottom': 'None')))
          }
        }
      }
      listview listView3 (
        DataSource: $Message/ConversationalUI.Source_Message,
        PageSize: 10,
        Class: 'listview-hide-on-empty'
      ) {
        -- Context: $currentObject (ConversationalUI.Source_Message), $listView3 (selection)
        layoutgrid layoutGrid1 {
          row (VerticalAlignment: Center) {
            column (DesktopWidth: AutoFit, TabletWidth: AutoFit, PhoneWidth: AutoFit) {
            }
            column (DesktopWidth: AutoFill) {
              linkbutton actionButton4 (
                Caption: '{1}',
                CaptionParams: ({1} = Title),
                Action: show page ConversationalUI.Source_View(Source = $currentObject),
                Class: 'source-btn',
                DesignProperties: ('Size': 'Small')
              )
            }
          }
        }
      }
    }
  }
};

create or modify snippet ConversationalUI.Snippet_Message_StatusHandling folder 'Private/Conversational UI/Resources/Snippets' (Params: ( $Message: ConversationalUI.Message )) {
  layoutgrid layoutGrid2 (Class: 'spacing-outer-bottom-small', Visible: $Message."Status" in ("Error")) {
    row (VerticalAlignment: Center) {
      column (DesktopWidth: AutoFit, TabletWidth: AutoFit, PhoneWidth: AutoFit) {
      }
      column (DesktopWidth: AutoFill, TabletWidth: AutoFit, PhoneWidth: AutoFit) {
        dynamictext text10 (
          Content: 'Error',
          DesignProperties: ('Color': 'Brand Danger', 'Spacing': ('margin-left': 'None'))
        )
      }
    }
  }
  container container4 (
    Class: 'chat-loading-wrapper',
    DesignProperties: ('Spacing': ('margin-top': 'S', 'margin-bottom': 'S')),
    Visible: $Message."Status" in (Loading)
  ) {
    container container7 (Class: 'loading-dot')
    container container6 (Class: 'loading-dot')
    container container5 (Class: 'loading-dot')
  }
};

create or modify snippet ConversationalUI.Snippet_SpanDuration folder 'Private/Traceability/Pages/Span' (Params: ( $Span: GenAICommons.Span )) {
  container container1 (Class: 'row-text-img') {
    dynamictext text1 (
      Content: '{1}',
      ContentParams: ({1} = if $Span/DurationMilliseconds = empty then '-'
else if round(($Span/DurationMilliseconds:1000), 1) = 0 then '0.0s' 
else formatDecimal(round(($Span/DurationMilliseconds:1000), 1)) + 's')
    )
  }
};

create or modify snippet ConversationalUI.Snippet_SpanEndTime folder 'Private/Traceability/Pages/Span' (Params: ( $Span: GenAICommons.Span )) {
  container container1 (Class: 'row-left-aligned') {
    dynamictext text1 (Content: '{1}', ContentParams: ({1} = $Span.EndTime format (dateFormat: DateTime)))
  }
};

create or modify snippet ConversationalUI.Snippet_SpanStartTime folder 'Private/Traceability/Pages/Span' (Params: ( $Span: GenAICommons.Span )) {
  container container1 (Class: 'row-text-img') {
    dynamictext text1 (Content: '{1}', ContentParams: ({1} = $Span.StartTime format (dateFormat: DateTime)))
  }
};

create or modify snippet ConversationalUI.Snippet_SpanTreeView folder 'Private/Traceability/Pages/Trace' (Params: ( $SpanTreeView: ConversationalUI.SpanTreeView )) {
  container container65 (Class: 'row-text-img spacing-inner-left-large') {
    container container66 (Class: 'agent-trace-icon-container ')
    tooltip tooltip8 (
      renderMethod: 'custom',
      tooltipPosition: 'right',
      arrowPosition: 'end',
      openOn: 'hover',
      Class: 'agent-tooltip'
    ) {
      htmlmessage {
        container container67 (Class: 'tooltip-container') {
          dynamictext text30 (Content: '{1}', ContentParams: ({1} = $SpanTreeView.Title))
        }
      }
      trigger {
        dynamictext text29 (
          Content: '{1}',
          ContentParams: ({1} = $SpanTreeView.Title),
          Class: 'font-size-medium text-break-word text-clamp--1-line'
        )
      }
    }
    dataview dataView11 (
      DataSource: $SpanTreeView/ConversationalUI.SpanTreeView_Span,
      ShowFooter: true,
      ReadOnlyStyle: Control
    ) {
      -- Context: $currentObject (ConversationalUI.SpanTreeView_Span)
