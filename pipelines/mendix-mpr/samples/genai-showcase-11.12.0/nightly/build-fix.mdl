    begin
      @position(150, 100)
      call microflow AgentCommons.Version_Delete(Version = $IteratorVersion);
    end loop;
    @position(232, 129)
    @curve(from: (30, 0), to: (-15, 0))
    retrieve $DeployedModel from GenAICommons.DeployedModel
    where [_QualifiedName = $AgentFromModel/Model]
    [Model = $AgentFromModel/SelectedModelID]
    first;
    @position(408, 129)
    @merge(543, 129)
    @caption 'found?'
    if $DeployedModel != empty then
    else
      @position(408, 247)
      @anchor(to: top)
      @curve(to: (0, 15))
      log warning node @AgentEditorCommons.LogNode 'The Model for Agent ''{1}'' was not configured correctly.
In order to make use of the Agent in the current app runtime and in the playground in Studio Pro, make sure to configure Model ''{2}'' correctly.' with ({1} = $QualifiedName, {2} = $AgentFromModel/Model);
    end if;
    @position(693, 129)
    @curve(from: (30, 0), to: (-30, 0))
    $UsageType = call microflow AgentEditorCommons.UsageType_StringToENUM(UsageType = $AgentFromModel/UsageType);
    @position(883, 129)
    $ToolChoice = call microflow AgentEditorCommons.ToolChoice_StringToENUM(ToolChoice = $AgentFromModel/ToolChoice);
    @position(1073, 129)
    @curve(from: (30, 0), to: (-30, 0))
    change $Agent (Title = if find($QualifiedName, '.') != -1 then
  substring($QualifiedName, find($QualifiedName, '.')+1, length($QualifiedName)-1-find($QualifiedName, '.'))
else 
  $QualifiedName, Description = $AgentFromModel/Description, UsageType = $UsageType, Entity = $AgentFromModel/Entity, AgentCommons.Agent_Version_InUse = $FirstVersion, _QualifiedName = $QualifiedName, AgentOwner = 'Studio Pro');
    @position(1263, 129)
    @curve(from: (30, 0), to: (-30, 0))
    change $FirstVersion (SystemPrompt = $AgentFromModel/SystemPrompt, UserPrompt = if $Agent/UsageType = AgentCommons.ENUM_Agent_UsageType.Single_Call
then $AgentFromModel/UserPrompt
else empty, Temperature = $AgentFromModel/Temperature, MaxTokens = $AgentFromModel/MaxTokens, TopP = $AgentFromModel/TopP, AgentCommons.Version_DeployedModel = $DeployedModel, ToolChoice = $ToolChoice, AgentCommons.Version_ToolChoice = if $ToolChoice != GenAICommons.ENUM_ToolChoice.tool
then empty
else $FirstVersion/AgentCommons.Version_ToolChoice);
    @position(1453, 129)
    @curve(from: (30, 0), to: (-30, 0))
    call microflow AgentCommons.Version_Commit(Version = $FirstVersion);
    @position(1663, 129)
    @curve(from: (30, 0), to: (-30, 0))
    call microflow AgentEditorCommons.Agent_UpdateVariables(Agent = $Agent, AgentFromModel = $AgentFromModel);
    @position(1878, 129)
    @curve(from: (30, 0), to: (-30, 0))
    call microflow AgentEditorCommons.Agent_UpdateTools(Version = $FirstVersion, AgentFromModel = $AgentFromModel);
    @position(2073, 129)
    call microflow AgentEditorCommons.Agent_UpdateKnowledgeBases(Version = $FirstVersion, AgentFromModel = $AgentFromModel);
    @position(2263, 129)
    call microflow AgentCommons.Agent_Commit(Agent = $Agent);
    @position(2403, 129)
    return $Agent;
  else
    @position(-1158, 259)
    @anchor(from: bottom, to: top)
    log error node @AgentEditorCommons.LogNode 'An agent ({2}) was defined in the Mendix Model that could not be imported. Please make sure the agent document is defined correctly. Validation info:
{1}' with ({1} = trim($ValidationMessage), {2} = $QualifiedName);
    @position(-1158, 369)
    @anchor(to: top)
    return empty;
  end if;
end;

create or modify microflow ChatCompletions_FunctionCalling.ChatContext_ChatWithHistory_ActionMicroflow_FunctionCalling (
  @position(-327, -190)
  $ChatContext: ConversationalUI.ChatContext
)
returns Boolean
folder 'ActionMicroflows'
begin
  @annotation(text: 'Conversational UI post-processing UI logic', position: (877, -215), size: (200, 50))
  @annotation(text: 'Conversational UI pre-processing UI logic', position: (-8, -215), size: (180, 50))
  @start(-327, -70)
  @position(-187, -70)
  @curve(to: (-30, 0))
  $Agent_Chat = call microflow AgentCommons.Agent_GetCreate_Json(AgentTitle = 'Ticket Assistant - Chat', AgentJson = '{
    "Title": "Ticket Assistant - Chat",
    "Description": "This agent is used in an example to showcase function / tool calling capabilities. Tools about a IT ticket dataset are added to the agent, so users can get insights.",
    "UsageType": "Conversational",
    "UUID": "9321b39e-29be-41b8-ba6c-0d6edcd59a2e",
    "Versions": [
        {
            "Title": "Initial",
            "SystemPrompt": "You are a helpful and user-friendly assistant supporting users with their questions by calling functions and avoiding internal technical terms. If you are unsure which function to call or cannot find the right answer, do not guess the function or answer; ask the user for clarification or inform them that you do not have the right information.  Before calling a function, you do not need to ask for permission or describe what you intend to do. Today is {{DateToday}}",
            "VersionNumber": 1,
            "UUID": "9751b7ad-fd82-4e2a-b292-9928707af08b",
            "VersionChangedDate": "2026-03-19T10:26:36.191Z",
            "Tools": [
                {
                    "Name": "GetNewestTicket",
                    "Description": "Get ticket details of the newest/latest ticket that was created.",
                    "Microflow": "ChatCompletions_FunctionCalling.Ticket_GetNewestTicket_FunctionMicroflow",
                    "DisplayTitle": "Find newest ticket",
                    "UserAccessApproval": "VisibleForUser",
                    "IsEnabled": true,
                    "UUID": "7289e2b2-8fd7-4a68-8399-7197050b8a98"
                },
                {
                    "Name": "RetrieveNumberOfTicketsInStatusAndCategory",
                    "Description": "Get number of tickets in a certain status and category. \n",
                    "Microflow": "ChatCompletions_FunctionCalling.Ticket_GetNumberOfTicketsInStatusCategory_FunctionMicroflow",
                    "DisplayTitle": "Get number of tickets in status and category",
                    "UserAccessApproval": "VisibleForUser",
                    "IsEnabled": true,
                    "UUID": "f9751add-d406-4c18-bd3c-7e949d340210"
                },
                {
                    "Name": "RetrieveTicketByIdentifier",
                    "Description": "Get ticket details based on a unique ticket identifier. If there is no information for this identifier, inform the user about it.",
                    "Microflow": "ChatCompletions_FunctionCalling.Ticket_GetTicketByID_FunctionMicroflow",
                    "DisplayTitle": "Get ticket information",
                    "DisplayDescription": "Looks up a specific ticket in the database",
                    "UserAccessApproval": "VisibleForUser",
                    "IsEnabled": true,
                    "UUID": "5ef56c63-6947-449c-808e-5ad6091ef127"
                },
                {
                    "Name": "RetrieveNumberOfTicketsInDateRange",
                    "Description": "Get number of tickets in a certain date time range (specify start and end date/time).",
                    "Microflow": "ChatCompletions_FunctionCalling.Ticket_GetNumberOfTicketsInDateRange_FunctionMicroflow",
                    "DisplayTitle": "Get number of tickets in time frame",
                    "UserAccessApproval": "VisibleForUser",
                    "IsEnabled": true,
                    "UUID": "2f176dee-8233-475c-b4b1-cf01825508e6"
                },
                {
                    "Name": "CreateNewTicket",
                    "Description": "Creates a new ticket for the given input and commits it.",
                    "Microflow": "ChatCompletions_FunctionCalling.Ticket_CreateNewTicket_FunctionMicroflow",
                    "DisplayTitle": "Create new ticket",
                    "DisplayDescription": "This will create a new ticket and submit it for the helpdesk to handle",
                    "UserAccessApproval": "UserConfirmationRequired",
                    "IsEnabled": true,
                    "UUID": "724c21e9-1f6e-479f-9131-1affe99a7462"
                }
            ],
            "MCPs": [],
            "SingleMCPTools": [],
            "DeployedModel": {
                "Architecture": "Mendix Cloud",
                "Model": "eu.anthropic.claude-sonnet-4-5-20250929-v1:0"
            },
            "KnowledgeBases": []
        }
    ],
    "Variables": [
        {
            "Key": "DateToday"
        }
    ],
    "Version_InUse": {
        "UUID": "9751b7ad-fd82-4e2a-b292-9928707af08b"
    },
    "TestCases": [],
    "Entity": "ChatCompletions_FunctionCalling.Task"
}');
  @position(-8, -70)
  @curve(from: (30, 0), to: (-15, 0))
  $Request = call microflow ConversationalUI.ChatContext_Preprocessing(ChatContext = $ChatContext);
  @position(147, -70)
  @caption 'Request found'
  if $Request != empty then
    @position(322, -70)
    $NewTask = create ChatCompletions_FunctionCalling.Task (DateToday = [%CurrentDateTime%]);
    @position(512, -70)
    @curve(to: (-15, 0))
    $Response = call java action AgentCommons.Agent_Call_WithHistory(Agent = $Agent_Chat, Request = $Request, ContextObjectType = 'ChatCompletions_FunctionCalling.Task', OptionalContextObject = $NewTask);
    @position(667, -70)
    @caption 'Response message?'
    if $Response/GenAICommons.Response_Message != empty then
      @position(882, -70)
      @curve(from: (30, 0), to: (-15, 0))
      call microflow ConversationalUI.ChatContext_UpdateAssistantResponse(ChatContext = $ChatContext, MessageStatus = ConversationalUI.ENUM_MessageStatus.Success, Response = $Response);
      @position(1047, -70)
      return true;
    else
      @position(667, 40)
      @anchor(to: top)
      return false;
    end if;
  else
    @position(147, 70)
    @anchor(to: top)
    return false;
  end if;
end;

