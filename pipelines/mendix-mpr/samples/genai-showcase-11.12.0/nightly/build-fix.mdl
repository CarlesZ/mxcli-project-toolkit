create or modify microflow MxGenAIConnector.ChatCompletions_Execute_WithHistory (
  @position(-150, 180)
  $DeployedModel: GenAICommons.DeployedModel,
  @position(-150, 85)
  $Request: GenAICommons.Request
)
returns GenAICommons.Response
folder 'Private/Objects/Converse/Request'
begin
  @start(-150, 350)
  @position(-45, 350)
  @caption 'Request found?'
  if $Request != empty then
    @position(171, 350)
    @curve(from: (30, 0), to: (-15, 0))
    $MxCloudDeployedModel = call microflow MxGenAIConnector.DeployedModel_GetMxCloudDeployedModel(DeployedModel = $DeployedModel);
    @position(401, 350)
    @caption 'Deployed Model found?'
    if $MxCloudDeployedModel != empty then
      @position(586, 350)
      @curve(from: (30, 0), to: (-15, 0))
      $Validation = call microflow MxGenAIConnector.MxCloudDeployedModel_Validate_ForChat(MxCloudDeployedModel = $MxCloudDeployedModel, Request = $Request);
      @position(766, 350)
      @caption 'Is Valid'
      if trim($Validation) = '' then
        @position(942, 350)
        call microflow GenAICommons.Request_ToolChoiceNone_RemoveTools(Request = $Request);
        @position(1131, 350)
