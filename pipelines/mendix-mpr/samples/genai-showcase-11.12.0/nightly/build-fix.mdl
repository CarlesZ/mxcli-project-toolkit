-- Part 3: mutual recursion.
-- Mutual recursion (GenAICommons.ChatCompletions_WithHistory <-> Response_CallRecursively): exec refuses a forward
-- reference, so create the callee as a stub, create the caller, then replace the stub with the real body.
create or modify microflow GenAICommons.Response_CallRecursively (
  @position(-751, 107)
  $Response: GenAICommons.Response,
  @position(-751, 25)
  $Request: GenAICommons.Request,
  @position(-751, -63)
  $DeployedModel: GenAICommons.DeployedModel
)
returns GenAICommons.Response as $Response
folder '_Private/Response'
begin
  return $Response;
end;

/**
 * Action can be used to invoke a chat completions API with a request containing a list of (historical) messages comprising the conversation so far. This action is provider agnostic.
 * - Request: Contains messages and optional attributes.
 * - DeployedModel: Contains the name of the microflow to be executed for the specified model and other information relevant to connect to a model. The OutputModality needs to be Text.
 */
create or modify microflow GenAICommons.ChatCompletions_WithHistory (
  @position(-1395, -146)
  $Request: GenAICommons.Request,
  @position(-1395, -260)
  $DeployedModel: GenAICommons.DeployedModel
)
returns GenAICommons.Response as $Response
folder 'Text & Files'
exposed as microflow action 'Chat Completions (with history)' in 'GenAI (Generate)'
export level api
begin
  @start(-1395, -45)
  @position(-1270, -45)
  @curve(from: (30, 0), to: (-30, 0))
  $Trace = call microflow GenAICommons.Trace_GetCreate(Request = $Request);
  @position(-1071, -45)
  @curve(from: (30, 0), to: (-30, 0))
  $Message = call microflow GenAICommons.Request_GetLastAssistantMessage(Request = $Request);
  @position(-863, -45)
  @curve(from: (30, 0), to: (-15, 0))
  $AreToolResultsReady = call microflow GenAICommons.Message_AreToolResultsReady(Message_Assistant = $Message, Request = $Request);
  @position(-690, -45)
  @caption 'AreToolResultsReady?'
  if $AreToolResultsReady then
    @position(-516, -45)
    declare $StartTime DateTime = [%CurrentDateTime%];
    @position(-320, -45)
    $ModelSpan = call microflow GenAICommons.ModelSpan_Create(DeployedModel = $DeployedModel, Trace = $Trace);
    @position(-103, -45)
    @curve(from: (30, 0), to: (-15, 0))
    $Response = call java action GenAICommons.Request_ChatCompletions_WithHistory(Request = $Request, DeployedModel = $DeployedModel) on error without rollback begin
      join rejoin1;
    end error;
    @position(97, -45)
    @caption 'Response?'
    if $Response != empty then
      @position(267, -45)
      @curve(from: (30, 0), to: (-30, 0))
      call microflow GenAICommons.Response_PostProcessing(Response = $Response, Request = $Request, DeployedModel = $DeployedModel, ModelSpan = $ModelSpan, Trace = $Trace, StartTime = $StartTime);
      @position(452, -45)
      $Response_Recursive = call microflow GenAICommons.Response_CallRecursively(Response = $Response, Request = $Request, DeployedModel = $DeployedModel);
      @position(592, -45)
      return $Response_Recursive;
    else
      @position(97, 77)
      merge rejoin1;
      @position(97, 195)
      @anchor(from: bottom, to: top)
      @curve(from: (0, 30), to: (0, -15))
      call microflow GenAICommons.Response_PostProcessing_Error(Request = $Request, DeployedModel = $DeployedModel, ModelSpan = $ModelSpan, Trace = $Trace, StartTime = $StartTime, Error = $latestError);
      @position(97, 307)
      @anchor(to: top)
      return empty;
    end if;
  else
    @position(-690, 156)
    @anchor(from: bottom, to: top)
    $Response_ToolCalls = call microflow GenAICommons.Message_Assistant_ProcessInput(Message_Assistant = $Message, Request = $Request);
    @position(-690, 268)
    @anchor(to: top)
    return $Response_ToolCalls;
  end if;
end;

drop microflow GenAICommons.Response_CallRecursively;
create or modify microflow GenAICommons.Response_CallRecursively (
  @position(-751, 107)
  $Response: GenAICommons.Response,
  @position(-751, 25)
  $Request: GenAICommons.Request,
  @position(-751, -63)
  $DeployedModel: GenAICommons.DeployedModel
)
returns GenAICommons.Response as $Response
folder '_Private/Response'
begin
  @annotation(text: 'If there are tools that require the user interface to be updated, we cannot resurively run Chat Completions but need to go back to the UI layer and wait for recall.', position: (643, 107), size: (240, 80))
  @start(-751, 220)
  @position(-626, 220)
  @caption 'Don''t save tool calls?'
  @annotation(text: 'Only for without history cases where no tool messages need to be persisted in the UI for later calls.', position: (-365, 128), size: (250, 70))
  if not($Request/SaveToolCallHistory) then
    @position(-451, 220)
    retrieve $Message from $Response/GenAICommons.Response_Message;
    @position(-276, 220)
    @caption 'ToolCalls?'
    if $Message/GenAICommons.Message_ToolCall != empty then
      @position(-101, 220)
      @curve(from: (30, 0), to: (-30, 0))
      change $Request (_ID = if trim($Request/_ID) != ''
then $Request/_ID
else $Response/_ID);
      @position(87, 220)
      @curve(from: (30, 0), to: (-30, 0))
      retrieve $ToolCollection from $Request/GenAICommons.Request_ToolCollection;
      @position(276, 220)
      @curve(from: (30, 0), to: (-30, 0))
      retrieve $ToolList from $ToolCollection/GenAICommons.ToolCollection_Tool;
      @position(468, 220)
      @curve(from: (30, 0), to: (-15, 0))
      $Tool_Visible = find $ToolList where $currentObject/UserAccessApproval = GenAICommons.ENUM_UserAccessApproval.UserConfirmationRequired
or $currentObject/UserAccessApproval = GenAICommons.ENUM_UserAccessApproval.VisibleForUser;
      @position(643, 220)
      @caption 'No ToolCall visible?'
      if $Tool_Visible = empty then
        @position(818, 220)
        $NewResponse = call microflow GenAICommons.ChatCompletions_WithHistory(Request = $Request, DeployedModel = $DeployedModel);
        @position(958, 220)
        return $NewResponse;
      else
        @position(643, 330)
        @anchor(to: top)
        return $Response;
      end if;
    else
      @position(-276, 330)
      @anchor(to: top)
      return $Response;
    end if;
  else
    @position(-626, 330)
    @anchor(to: top)
    return $Response;
  end if;
end;

-- Part 4/5: rules, Java actions, message definitions, mappings, microflows, pages and snippets.
create or modify rule AgentCommons.Rule_Agent_IsManuallyCreated (
  @position(446, 95)
  $Agent: AgentCommons.Agent
)
returns Boolean
folder 'Private/Objects/Agent'
begin
  @start(446, 200)
  @position(571, 200)
  @caption 'manually created? '
  if trim($Agent/ModelDocumentID) = '' then
    @position(700, 200)
    return true;
  else
    @position(571, 292)
    @anchor(to: top)
    return false;
  end if;
end;

create or modify rule AgentCommons.Rule_KnowledgeBaseList_Equals (
  @position(-231, -14)
  $KnowledgeBaseList_Right: List of AgentCommons.KnowledgeBase,
  @position(-231, 76)
  $KnowledgeBaseList_Left: List of AgentCommons.KnowledgeBase
)
returns Boolean
folder 'Private/Objects/KnowledgeBase'
begin
  @start(-231, 200)
  @position(-87, 200)
  @curve(to: (-30, 0))
  $Count_Right = count $KnowledgeBaseList_Right;
  @position(103, 200)
  @curve(to: (-15, 0))
  $Count_Left = count $KnowledgeBaseList_Left;
  @position(303, 200)
  @caption 'same number of elements?'
  if $Count_Left = $Count_Right then
    @position(478, 200)
    declare $MismatchFound Boolean = false;
    @position(918, 200)
    @anchor(from: right, to: left)
    loop $IteratorKnowledgeBase in $KnowledgeBaseList_Right
    begin
      @position(143, 139)
      $KnowledgeBase_Left_Duplicate = find $KnowledgeBaseList_Left where $currentObject/AgentCommons.KnowledgeBase_ConsumedKnowledgeBase= $IteratorKnowledgeBase/AgentCommons.KnowledgeBase_ConsumedKnowledgeBase and
$currentObject/CollectionIdentifier = $IteratorKnowledgeBase/CollectionIdentifier and
$currentObject/Description = $IteratorKnowledgeBase/Description and
$currentObject/MaxNumberOfResults = $IteratorKnowledgeBase/MaxNumberOfResults and
$currentObject/MinimumSimilarity = $IteratorKnowledgeBase/MinimumSimilarity and
$currentObject/Name = $IteratorKnowledgeBase/Name;
      @position(320, 139)
      @caption 'difference?'
      if $KnowledgeBase_Left_Duplicate = empty then
        @position(484, 139)
        set $MismatchFound = true;
        @position(579, 139)
        break;
      else
        @position(320, 227)
        @anchor(to: top)
        continue;
      end if;
    end loop;
    @position(1390, 200)
    @caption 'no Mismatch found?'
    if $MismatchFound = false then
      @position(1515, 200)
      return true;
    else
      @position(1390, 288)
      @anchor(to: top)
      return false;
    end if;
  else
    @position(303, 288)
    @anchor(to: top)
    return false;
  end if;
end;

